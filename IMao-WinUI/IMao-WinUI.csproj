<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>IMao_WinUI</RootNamespace>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultPriItems>true</EnableDefaultPriItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <BaseOutputPath>..\</BaseOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SupportedLanguages>en-US;zh-CN</SupportedLanguages>
    <GenerateAllLanguageResourcePacks>false</GenerateAllLanguageResourcePacks>
    <GenerateResourceResourcePacks>false</GenerateResourceResourcePacks>
    <!-- The repository asset is the icon's single source of truth: release staging copies it into the
         packaged Assets directory and the window icon is loaded from there at runtime. Embedding it into
         the executable from a second copy is what left IMao-WinUI.exe showing an older icon, so the
         application icon now points at the same file the package ships. -->
    <ApplicationIcon>..\Assets\WindowIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <Target Name="StageResourceUpdateSnapshot" AfterTargets="CopyFilesToOutputDirectory">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Stage-UpdateResources.ps1&quot; -Destination &quot;$(TargetDir).&quot; -Version &quot;$(IMaoVersion)&quot; -BaselineId &quot;$(IMaoBaselineId)&quot;" />
  </Target>

  <!-- The browser extension reaches IMao through a Native Messaging host. The app
       registers that host for the current user, so the bridge has to ship with
       every build and publish output. -->
  <Target Name="StageKuroSyncBridgeToOutput" AfterTargets="CopyFilesToOutputDirectory">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; publish &quot;$(MSBuildProjectDirectory)\..\tools\KuroSyncBridge\KuroSyncBridge.csproj&quot; -c Release -r win-x64 -p:Platform=x64 --self-contained false -p:PublishSingleFile=true -o &quot;$(TargetDir).kuro-bridge&quot; --source &quot;$(NuGetPackageRoot)&quot; -p:NuGetAudit=false" />
    <Copy SourceFiles="$(TargetDir).kuro-bridge\KuroSyncBridge.exe" DestinationFolder="$(TargetDir)" />
  </Target>

  <Target Name="StageKuroSyncBridgeToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir).kuro-bridge\KuroSyncBridge.exe" DestinationFolder="$(PublishDir)" />
  </Target>
  <Target Name="StagePublishedResourceUpdateSnapshot" AfterTargets="Publish">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Stage-UpdateResources.ps1&quot; -Destination &quot;$(PublishDir).&quot; -Version &quot;$(IMaoVersion)&quot; -BaselineId &quot;$(IMaoBaselineId)&quot;" />
  </Target>
  <Target Name="GenerateVersionedPackageManifest" BeforeTargets="_GenerateCurrentProjectAppxManifest">
    <PropertyGroup>
      <VersionedAppxManifest>$(IntermediateOutputPath)VersionedPackage.appxmanifest</VersionedAppxManifest>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Package.appxmanifest" DestinationFiles="$(VersionedAppxManifest)" />
    <XmlPoke XmlInputPath="$(VersionedAppxManifest)" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version" Value="$(IMaoVersion)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(VersionedAppxManifest)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.1.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.250402" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="6.0.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="2.0.9" />
    <PackageReference Include="WinUIEx" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IMao-WinUI.Core\IMao-WinUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\th.jpg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="StringItems\StringItems.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\th.jpg" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
 
<!-- 删除其他语言文件夹 -->
<Target Name="CopyKuroMapAssets" AfterTargets="CopyFilesToOutputDirectory">
  <ItemGroup>
    <KuroMapAssets Include="$(MSBuildProjectDirectory)\..\Assets\KuroMap\**\*" />
  </ItemGroup>
  <MakeDir Directories="$(TargetDir)Assets\KuroMap" Condition="Exists('$(MSBuildProjectDirectory)\..\Assets\KuroMap')" />
  <Copy SourceFiles="@(KuroMapAssets)"
        DestinationFiles="@(KuroMapAssets->'$(TargetDir)Assets\KuroMap\%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true"
        Condition="'@(KuroMapAssets)' != ''" />
</Target>

<Target Name="CopyKuroTileFeaturePackAssets" AfterTargets="CopyFilesToOutputDirectory">
  <ItemGroup>
    <KuroTileFeaturePackRegistry Include="$(MSBuildProjectDirectory)\..\Assets\FeaturesDatas\kuro-tile-packs.json" />
    <KuroTileFeaturePackAssets Include="$(MSBuildProjectDirectory)\..\Assets\FeaturesDatas\KuroTilePacks\**\*" />
  </ItemGroup>
  <MakeDir Directories="$(TargetDir)Assets\FeaturesDatas" Condition="Exists('$(MSBuildProjectDirectory)\..\Assets\FeaturesDatas\kuro-tile-packs.json')" />
  <MakeDir Directories="$(TargetDir)Assets\FeaturesDatas\KuroTilePacks" Condition="Exists('$(MSBuildProjectDirectory)\..\Assets\FeaturesDatas\KuroTilePacks')" />
  <Copy SourceFiles="@(KuroTileFeaturePackRegistry)"
        DestinationFiles="@(KuroTileFeaturePackRegistry->'$(TargetDir)Assets\FeaturesDatas\%(Filename)%(Extension)')"
        SkipUnchangedFiles="true"
        Condition="'@(KuroTileFeaturePackRegistry)' != ''" />
  <Copy SourceFiles="@(KuroTileFeaturePackAssets)"
        DestinationFiles="@(KuroTileFeaturePackAssets->'$(TargetDir)Assets\FeaturesDatas\KuroTilePacks\%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true"
        Condition="'@(KuroTileFeaturePackAssets)' != ''" />
</Target>

<Target Name="CleanUnsupportedLanguages" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(Platform)'!='' and '$(Configuration)'!=''">
  <PropertyGroup>
    <RootOutputDir>$([System.IO.Path]::GetFullPath('$(BaseOutputPath)$(Platform)\$(Configuration)'))</RootOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 保留根目录的 en-us/zh-CN -->
    <KeepFolders Include="$(RootOutputDir)\en-us" />
    <KeepFolders Include="$(RootOutputDir)\zh-CN" />
    <!-- 保留子目录中的 en-us/zh-CN（如 runtimes\win-x64\native\en-us） -->
    <KeepFolders Include="$(RootOutputDir)\**\en-us" />
    <KeepFolders Include="$(RootOutputDir)\**\zh-CN" />
  </ItemGroup>

  <ItemGroup>
    <TargetMuiFiles Include="$(RootOutputDir)\**\Microsoft.ui.xaml.dll.mui;$(RootOutputDir)\**\Microsoft.UI.Xaml.Phone.dll.mui" />
    <LanguageFoldersWithMui Include="$([System.IO.Path]::GetDirectoryName(%(TargetMuiFiles.FullPath)))" />
    <UniqueLanguageFolders Include="@(LanguageFoldersWithMui)" Distinct="true" />
  </ItemGroup>

  <ItemGroup>
    <UnsupportedFolders Include="@(UniqueLanguageFolders)" Exclude="@(KeepFolders)" />
  </ItemGroup>

  <RemoveDir Directories="@(UnsupportedFolders)" Condition="Exists('%(FullPath)')" ContinueOnError="true" />
</Target>
</Project>
