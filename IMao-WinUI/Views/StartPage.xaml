<Page x:Class="IMao_WinUI.Views.StartPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="22">
        <StackPanel Spacing="5"><TextBlock Text="EXPLORATION COMPANION" Style="{StaticResource IMaoEyebrowStyle}" /><TextBlock Text="让每次探索，都有方向。" Style="{StaticResource IMaoPageTitleStyle}" /><TextBlock Text="在游戏地图上看见目标，沿自己的路线继续前进。" Style="{StaticResource IMaoSecondaryTextStyle}" /></StackPanel>
        <Border Style="{StaticResource IMaoCardStyle}" Padding="24">
            <StackPanel Spacing="18">
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8"><FontIcon Glyph="&#xE774;" Foreground="{StaticResource IMaoAccentBrush}" /><TextBlock x:Name="Start_TextBlock_CoreState" Text="正在连接核心" Style="{StaticResource IMaoSectionTitleStyle}" /></controls:WrapPanel>
                <TextBlock x:Name="Start_TextBlock_CoreDetail" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <TextBlock x:Name="OverviewLocationSummary" Style="{StaticResource IMaoBodyTextStyle}" />
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <Button x:Name="Start_Button" Click="Start_Button_Click" Style="{StaticResource IMaoPrimaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon x:Name="Start_Button_Icon" Glyph="&#xE768;" FontSize="16" /><TextBlock x:Name="Start_Button_Text" Text="开始探索" /></StackPanel></Button>
                    <Button Content="重新连接核心" Click="RestartCore_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                    <Button Content="连接与显示设置" Tag="settings" Click="Navigate_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                </controls:WrapPanel>
                <InfoBar x:Name="Start_InfoBar_FindNotTargetProcess" IsOpen="False" Visibility="Collapsed" Title="正在等待游戏" Message="请先打开鸣潮，并回到可见的游戏画面。" Severity="Warning" CloseButtonClick="Start_InfoBar_FindNotTargetProcess_CloseButtonClick" />
                <InfoBar x:Name="Start_InfoBar_IncorrectGameWindowSize" IsOpen="False" Visibility="Collapsed" Title="检查游戏窗口" Message="当前窗口比例可能影响地图识别；建议使用 16:9 游戏画面。" Severity="Warning" CloseButtonClick="Start_InfoBar_IncorrectGameWindowSize_CloseButtonClick" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource IMaoCardStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="本次路线" Style="{StaticResource IMaoSectionTitleStyle}" />
                <TextBlock x:Name="OverviewRouteTitle" Text="还没有活动路线" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="OverviewRouteDetail" Text="先筛选感兴趣的点位，再到路线页选择本次目标。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <TextBlock x:Name="OverviewRouteTarget" Style="{StaticResource IMaoBodyTextStyle}" />
                <TextBlock x:Name="OverviewReplanStatus" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <Button Content="前往路线" Tag="routes" Click="Navigate_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource IMaoCardStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="地图与点位" Style="{StaticResource IMaoSectionTitleStyle}" />
                <TextBlock x:Name="OverviewMarkerSummary" Text="启动后显示当前地图点位数量。" Style="{StaticResource IMaoBodyTextStyle}" />
                <TextBlock Text="只显示你关心的收集物、宝箱和探索目标。筛选修改会保存到本地。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="筛选点位" Tag="filter" Click="Navigate_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" /><Button Content="查看使用帮助" Tag="help" Click="Navigate_Click" /><Button Content="诊断与日志" Tag="diagnostics" Click="Navigate_Click" /></controls:WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
