<Page
    x:Class="IMao_WinUI.Views.FilterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Enabled">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="FilterToolbar" Spacing="10">
            <TextBlock x:Uid="Filter_Page_Title" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="FilterDescription" TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock x:Name="language" x:Uid="language" Visibility="Collapsed" />
            <InfoBar x:Name="FilterWarning" IsOpen="False" IsClosable="True" Severity="Warning" />
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
            <controls:WrapPanel Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8">
                <ComboBox x:Name="CategoryPicker" Width="210" DisplayMemberPath="Name"
                          SelectionChanged="CategoryPicker_SelectionChanged" />
                <ComboBox x:Name="PresetPicker" Width="240" DisplayMemberPath="Name"
                          Visibility="Collapsed" SelectionChanged="PresetPicker_SelectionChanged" />
                <ToggleButton x:Name="SelectedOnly" Click="SelectedOnly_Click" />
            </controls:WrapPanel>
            <controls:WrapPanel Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8">
                <Button x:Name="SelectResults" Click="SelectResults_Click" />
                <Button x:Name="ClearResults" Click="ClearResults_Click" />
                <TextBlock x:Name="SelectionSummary" VerticalAlignment="Center" Margin="4,0" TextWrapping="Wrap" />
            </controls:WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <GridView x:Name="FilterItems" SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="224" Height="80" CornerRadius="8" Padding="10,4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Tag="{Binding}"
                                      Click="Item_Click"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding Detail}">
                                <Grid ColumnSpacing="8" Width="160">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"
                                               MaxLines="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <TextBlock x:Name="EmptyMessage" Visibility="Collapsed" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Opacity="0.7" />
        </Grid>
    </Grid>
</Page>
