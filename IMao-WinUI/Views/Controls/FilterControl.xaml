<UserControl
    x:Class="IMao_WinUI.Views.Controls.FilterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    SizeChanged="FilterControl_SizeChanged">
    <UserControl.Resources>
        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="IMaoAccentBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="IMaoAccentBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="IMaoAccentBrush" />
        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="IMaoCanvasBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="IMaoCanvasBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="IMaoCanvasBrush" />
        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="IMaoAccentBrush" />
    </UserControl.Resources>
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="FilterToolbarScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="FilterToolbar" Spacing="10">
            <TextBlock x:Name="FilterEyebrow" Text="POINT LIBRARY" Style="{StaticResource IMaoEyebrowStyle}" /><TextBlock x:Name="FilterTitle" Text="点位筛选" Style="{StaticResource IMaoPageTitleStyle}" />
            <TextBlock x:Name="FilterDescription" Style="{StaticResource IMaoSecondaryTextStyle}" />

            <InfoBar x:Name="FilterWarning" IsOpen="False" IsClosable="True" Severity="Warning" />
            <TextBox x:Name="SearchBox" TextChanging="SearchBox_TextChanging" />
            <controls:WrapPanel Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8">
                <ComboBox x:Name="CategoryPicker" Width="210" DisplayMemberPath="Name"
                          SelectionChanged="CategoryPicker_SelectionChanged" />
                <ComboBox x:Name="PresetPicker" Width="240" DisplayMemberPath="Name"
                          Visibility="Collapsed" SelectionChanged="PresetPicker_SelectionChanged" />
                <ToggleButton x:Name="SelectedOnly" Click="SelectedOnly_Click" /><Button x:Name="CatalogNotice" Content="筛选提示" Visibility="Collapsed"><Button.Flyout><Flyout><TextBlock x:Name="CatalogNoticeText" MaxWidth="340" TextWrapping="Wrap" /></Flyout></Button.Flyout></Button>
            </controls:WrapPanel>
            <controls:WrapPanel Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8">
                <Button x:Name="SelectResults" Click="SelectResults_Click" />
                <Button x:Name="ClearResults" Click="ClearResults_Click" />
                <TextBlock x:Name="SelectionSummary" VerticalAlignment="Center" Margin="4,0" TextWrapping="Wrap" />
            </controls:WrapPanel>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="SyncStatus" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" /><Button x:Name="RetrySync" Grid.Column="1" Content="重试同步" Click="RetrySync_Click" Visibility="Collapsed" /></Grid><TextBlock x:Name="GamepadHint" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
        </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1">
            <GridView x:Name="FilterItems" SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="224" Height="88" CornerRadius="10" Padding="10,4"
                                Background="{StaticResource IMaoSurfaceBrush}"
                                BorderBrush="{StaticResource IMaoBorderBrush}" BorderThickness="1">
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Tag="{Binding}"
                                      Click="Item_Click"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding Detail}">
                                <Grid ColumnSpacing="8" Width="160">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"
                                               MaxLines="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="15" />
                                </Grid>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <TextBlock x:Name="EmptyMessage" Visibility="Collapsed" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Opacity="0.7" />
        </Grid>
    </Grid>
</UserControl>
