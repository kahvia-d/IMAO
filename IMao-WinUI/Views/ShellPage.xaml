<Page
    x:Class="IMao_WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:IMao_WinUI.Helpers"
    xmlns:views="using:IMao_WinUI.Views"
    Loaded="OnLoaded"
    SizeChanged="ShellPage_SizeChanged"
    Background="{StaticResource IMaoCanvasBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 34px 标题栏高度与系统原生最小化/最大化/关闭按钮（32px）对齐，确保右侧三个窗口按钮垂直居中 -->
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 隐藏保留 NavigationViewControl，仅用于兼容 NavigationViewService 底层导航栈 -->
        <NavigationView
            x:Name="NavigationViewControl"
            Visibility="Collapsed"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Shell_Main" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.StartViewModel" />
                <NavigationViewItem x:Uid="Shell_Function" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.FunctionViewModel" />
                <NavigationViewItem x:Uid="Shell_Filter" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.FilterViewModel" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="Shell_Settings" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.SettingsViewModel">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdatesBadge" Visibility="Collapsed" Style="{ThemeResource AttentionDotInfoBadgeStyle}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_Diagnostics" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.DiagnosticsViewModel" />
                <NavigationViewItem x:Uid="Shell_Help" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.UsageGuideViewModel" />
            </NavigationView.FooterMenuItems>
        </NavigationView>

        <!-- 顶部简洁标题栏：仅保留应用图标与标题，与右侧系统窗口操作按钮垂直居中对齐 -->
        <Border Grid.Row="0" Background="{StaticResource IMaoSidebarBrush}" BorderBrush="{StaticResource IMaoBorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="AppTitleBar" Padding="14,0,144,0" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/WindowIcon.ico" Width="17" Height="17" VerticalAlignment="Center" />
                    <TextBlock x:Name="AppTitleBarText" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource IMaoTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体布局：左侧简洁导航栏 + 右侧主内容区 + 全局顶部悬浮消息栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧简洁导航栏 -->
            <Border x:Name="AetheriaSidebar" Grid.Column="0" Background="{StaticResource IMaoSidebarBrush}"
                    BorderBrush="{StaticResource IMaoBorderBrush}" BorderThickness="0,0,1,0" Padding="10,14">
                <StackPanel Spacing="4">
                    <Button x:Name="SidebarBtn_Start" Tag="IMao_WinUI.ViewModels.StartViewModel"
                            Click="SidebarNav_Click" Style="{StaticResource IMaoSidebarNavActiveButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="15" Foreground="{StaticResource IMaoAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="首页" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SidebarBtn_Routes" Tag="IMao_WinUI.ViewModels.FunctionViewModel"
                            Click="SidebarNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE816;" FontSize="15" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="路线导航" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SidebarBtn_Filter" Tag="IMao_WinUI.ViewModels.FilterViewModel"
                            Click="SidebarNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE71C;" FontSize="15" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="点位筛选" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{StaticResource IMaoBorderBrush}" Margin="6,8" />

                    <Button x:Name="SidebarBtn_Settings" Tag="IMao_WinUI.ViewModels.SettingsViewModel"
                            Click="SidebarNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="设置" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse x:Name="SidebarUpdateDot" Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource IMaoAccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="SidebarBtn_Diagnostics" Tag="IMao_WinUI.ViewModels.DiagnosticsViewModel"
                            Click="SidebarNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="运行诊断" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SidebarBtn_Help" Tag="IMao_WinUI.ViewModels.UsageGuideViewModel"
                            Click="SidebarNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE897;" FontSize="15" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="帮助文档" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 右侧主工作区画布 -->
            <ScrollViewer
                x:Name="PageScrollViewer"
                Grid.Column="1"
                Background="{StaticResource IMaoCanvasBrush}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Frame x:Name="NavigationFrame" Padding="24,18,24,24" Navigated="NavigationFrame_Navigated" />
            </ScrollViewer>

            <!-- 全局顶部悬浮消息栏：不占用页面布局空间，同时只显示最新一条，悬停暂停 4 秒自动消失计时 -->
            <Border
                x:Name="ToastOverlayHost"
                Grid.Column="1"
                Canvas.ZIndex="200"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="24,14,24,0"
                MinWidth="320"
                MaxWidth="660"
                CornerRadius="10"
                Padding="14,10"
                Background="#F5161F2E"
                BorderBrush="{StaticResource IMaoBorderStrongBrush}"
                BorderThickness="1"
                PointerEntered="ToastOverlayHost_PointerEntered"
                PointerExited="ToastOverlayHost_PointerExited">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ToastAccentBar" Grid.Column="0" Width="4" CornerRadius="2"
                            Background="{StaticResource IMaoAccentBrush}" VerticalAlignment="Stretch" />

                    <FontIcon x:Name="ToastIcon" Grid.Column="1" Glyph="&#xE946;" FontSize="16"
                              Foreground="{StaticResource IMaoAccentBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitleText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource IMaoTextBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                        <TextBlock x:Name="ToastMessageText" FontSize="13"
                                   Foreground="{StaticResource IMaoTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="3" Click="ToastClose_Click" Padding="6,4" MinWidth="26" MinHeight="26"
                            Background="Transparent" BorderThickness="0" CornerRadius="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
