<Page x:Class="IMao_WinUI.Views.ShellPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:IMao_WinUI.Helpers" Loaded="OnLoaded">
    <Grid Background="{StaticResource IMaoCanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="{StaticResource IMaoCanvasBrush}" Padding="20,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="/Assets/WindowIcon.ico" Width="22" Height="22" />
                <TextBlock x:Name="AppTitleBarText" Text="IMao" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="探索有迹可循" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="NavigationViewControl" Grid.Row="1" IsBackButtonVisible="Collapsed"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            IsSettingsVisible="False" OpenPaneLength="178" CompactPaneLength="52" ExpandedModeThresholdWidth="1000"
            CompactModeThresholdWidth="640" PaneDisplayMode="Auto" IsPaneToggleButtonVisible="True"
            Background="{StaticResource IMaoCanvasBrush}" DisplayModeChanged="NavigationViewControl_DisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.StartViewModel"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="点位筛选" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.FilterViewModel"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="路线" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.FunctionViewModel"><NavigationViewItem.Icon><FontIcon Glyph="&#xE707;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.SettingsViewModel"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon><NavigationViewItem.InfoBadge><InfoBadge x:Name="UpdatesBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge></NavigationViewItem>
                <NavigationViewItem Content="帮助" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.UsageGuideViewModel"><NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="诊断" helpers:NavigationHelper.NavigateTo="IMao_WinUI.ViewModels.DiagnosticsViewModel"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Frame x:Name="NavigationFrame" Navigated="NavigationFrame_Navigated" Margin="{StaticResource NavigationViewPageContentMargin}" MaxWidth="1240" HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Page>
