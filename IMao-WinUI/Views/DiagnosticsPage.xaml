<Page
    x:Class="IMao_WinUI.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <InfoBar x:Name="Diagnostics_Status" IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="Diagnostics_StatusTitle" Text="正在连接核心" FontWeight="SemiBold" />
                    <TextBlock x:Name="Diagnostics_StatusDetail" Text="等待实时状态" TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock x:Name="Diagnostics_CoreVersion" Text="CoreHost：-" Opacity="0.65" />
                </StackPanel>
            </InfoBar>

            <toolkit:SettingsExpander Header="诊断与日志" Description="事件日志始终保存；截图仅在手动启用诊断时采集。" CornerRadius="8">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="Diagnostics_CaptureToggle" Header="采集诊断截图" Toggled="Diagnostics_CaptureToggle_Toggled" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="日志目录">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开日志" Click="OpenLogs_Click" />
                            <Button Content="复制诊断摘要" Click="CopySummary_Click" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="崩溃报告">
                        <Button Content="打开崩溃报告目录" Click="OpenCrashes_Click" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <TextBlock Text="实时事件" FontSize="18" FontWeight="SemiBold" />
            <ListView x:Name="Diagnostics_LogList" MinHeight="220" MaxHeight="460" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
