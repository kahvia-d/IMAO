<Page
    x:Class="IMao_WinUI.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <InfoBar x:Name="Diagnostics_Status" IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="Diagnostics_StatusTitle" Text="正在连接核心" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="Diagnostics_StatusDetail" Text="等待实时状态" TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock x:Name="Diagnostics_CoreVersion" Text="CoreHost：-" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </InfoBar>

            <toolkit:SettingsExpander CornerRadius="8" IsExpanded="True">
                <toolkit:SettingsExpander.Header>
                    <TextBlock Text="诊断与日志" TextWrapping="Wrap" />
                </toolkit:SettingsExpander.Header>
                <toolkit:SettingsExpander.Description>
                    <TextBlock Text="事件日志始终保存；截图仅在手动启用诊断时采集。" TextWrapping="Wrap" />
                </toolkit:SettingsExpander.Description>
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <!-- A toggle header needs its own row; the expander header action area is compact. -->
                    <toolkit:SettingsCard ContentAlignment="Vertical">
                        <toolkit:SettingsCard.Header>
                            <TextBlock Text="采集诊断截图" TextWrapping="Wrap" />
                        </toolkit:SettingsCard.Header>
                        <ToggleSwitch x:Name="Diagnostics_CaptureToggle"
                                      AutomationProperties.Name="采集诊断截图"
                                      Toggled="Diagnostics_CaptureToggle_Toggled" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="日志目录" ContentAlignment="Vertical">
                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                            <Button Click="OpenLogs_Click">
                                <TextBlock Text="打开日志" TextWrapping="Wrap" />
                            </Button>
                            <Button Click="CopySummary_Click">
                                <TextBlock Text="复制诊断摘要" TextWrapping="Wrap" />
                            </Button>
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="崩溃报告" ContentAlignment="Vertical">
                        <Button Click="OpenCrashes_Click">
                            <TextBlock Text="打开崩溃报告目录" TextWrapping="Wrap" />
                        </Button>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <TextBlock Text="实时事件" FontSize="18" FontWeight="SemiBold" />
            <ListView x:Name="Diagnostics_LogList" MinHeight="220" MaxHeight="460" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
