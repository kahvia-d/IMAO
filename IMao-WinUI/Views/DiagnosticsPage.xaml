<Page x:Class="IMao_WinUI.Views.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <!-- 顶部采用紧凑双栏 Bento 遥测舱，将最大视口留给底部实时事件终端 -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 第一行：标题与右上角高级隔离开关/日志目录弹出面板 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="AETHERIA TELEMETRY &amp; BLACKBOX // 运行遥测与事件黑匣子" Style="{StaticResource IMaoEyebrowStyle}" />
                <TextBlock Text="遥测与诊断" Style="{StaticResource IMaoPageTitleStyle}" />
            </StackPanel>

            <Button Grid.Column="1" Content="高级隔离开关与日志目录" VerticalAlignment="Center" Style="{StaticResource IMaoSecondaryButtonStyle}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <ScrollViewer MaxHeight="360" Width="360" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10" Padding="4">
                                <TextBlock Text="ISOLATION &amp; LOG TOOLS · 性能定位与日志目录" Style="{StaticResource IMaoEyebrowStyle}" />
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Content="打开日志" Click="OpenLogs_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                                    <Button Content="复制诊断摘要" Click="CopySummary_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                                    <Button Content="打开崩溃报告" Click="OpenCrashes_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                                </controls:WrapPanel>
                                <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />
                                <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="隐藏叠加层窗口（仅采集）" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="测试掉帧是否来自叠加窗口本身" FontSize="11" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="Diagnostics_OverlayHiddenToggle" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" AutomationProperties.Name="隐藏叠加层窗口" Toggled="Diagnostics_OverlayHiddenToggle_Toggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="暂停叠加层画面更新" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="窗口保持显示，每 3 秒更新一次状态条" FontSize="11" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="Diagnostics_HoldPresentToggle" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" AutomationProperties.Name="暂停叠加层画面更新" Toggled="Diagnostics_HoldPresentToggle_Toggled" />
                                    </Grid>
                                </Border>
                                <NumberBox x:Name="Diagnostics_IsolationBox" Header="隔离开关掩码（0 ~ 1023）" AutomationProperties.Name="隔离开关" Minimum="0" Maximum="1023" SpinButtonPlacementMode="Compact" ValueChanged="Diagnostics_IsolationBox_ValueChanged" />
                                <TextBlock Text="1=关采集 · 2=关状态检测 · 4=关定位 · 8=关绘制 · 16=关清屏 · 32=关几何同步 · 64=DirectComposition · 128=整帧回读 · 256=整屏覆盖 · 512=停用鼠标钩子。正常为 0。"
                                           Style="{StaticResource IMaoSecondaryTextStyle}" FontSize="11.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 第二行：双栏 Bento 遥测头部（左「核心与 OCR 状态」 + 右「3 分钟短时采集控制舱」） -->
        <Grid Grid.Row="1" ColumnSpacing="14" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <InfoBar Grid.Column="0" x:Name="Diagnostics_Status" IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="12" VerticalAlignment="Stretch">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="Diagnostics_StatusTitle" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="Diagnostics_StatusDetail" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock x:Name="Diagnostics_OcrBackend" FontSize="12.5" Foreground="{StaticResource IMaoCyanBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Diagnostics_CoreVersion" Style="{StaticResource IMaoSecondaryTextStyle}" FontSize="11.5" />
                </StackPanel>
            </InfoBar>

            <Border Grid.Column="1" Style="{StaticResource IMaoHeroCardStyle}" Padding="14,10">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="短时完整采集（最多 3 分钟）" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        <controls:WrapPanel Grid.Column="1" HorizontalSpacing="6" VerticalSpacing="6">
                            <Button x:Name="Diagnostics_CaptureStart" Content="开始 3 分钟采集" Click="CaptureStart_Click" IsEnabled="False" Style="{StaticResource IMaoPrimaryButtonStyle}" Padding="10,5" FontSize="12" />
                            <Button x:Name="Diagnostics_CaptureStop" Content="提前停止" Click="CaptureStop_Click" IsEnabled="False" Style="{StaticResource IMaoSecondaryButtonStyle}" Padding="10,5" FontSize="12" />
                            <Button x:Name="Diagnostics_CaptureOpen" Content="打开采集文件夹" Click="CaptureOpen_Click" IsEnabled="False" Style="{StaticResource IMaoSecondaryButtonStyle}" Padding="10,5" FontSize="12" />
                        </controls:WrapPanel>
                    </Grid>
                    <ProgressBar x:Name="Diagnostics_CaptureProgress" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="采集进度" />
                    <InfoBar x:Name="Diagnostics_CaptureStatus" IsOpen="True" IsClosable="False" Severity="Informational" Title="采集暂不可用" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 第三行：星图黑匣子实时事件流终端 -->
        <Border Grid.Row="2" Style="{StaticResource IMaoCardStyle}" Padding="14,12" MinHeight="90">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="实时事件流" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <Border Grid.Column="1" Style="{StaticResource IMaoCyanPillBadgeStyle}">
                        <TextBlock Text="LIVE EVENT STREAM" FontSize="9.5" FontWeight="Bold" CharacterSpacing="70" Foreground="{StaticResource IMaoCyanBrush}" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource IMaoDeepInsetBrush}" BorderBrush="{StaticResource IMaoBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8,4">
                    <ListView x:Name="Diagnostics_LogList" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="0,3" FontSize="12.5"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" Foreground="{StaticResource IMaoTextBrush}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
