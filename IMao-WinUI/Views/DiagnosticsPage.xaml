<Page x:Class="IMao_WinUI.Views.DiagnosticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <Grid RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="5"><TextBlock Text="RUNTIME INSIGHT" Style="{StaticResource IMaoEyebrowStyle}" /><TextBlock Text="诊断" Style="{StaticResource IMaoPageTitleStyle}" /><TextBlock Text="查看运行状态，保留排查问题需要的线索。" Style="{StaticResource IMaoSecondaryTextStyle}" /></StackPanel>
        <InfoBar Grid.Row="1" x:Name="Diagnostics_Status" IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="10">
            <StackPanel Spacing="4"><TextBlock x:Name="Diagnostics_StatusTitle" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="Diagnostics_StatusDetail" TextWrapping="Wrap" /><TextBlock x:Name="Diagnostics_CoreVersion" Style="{StaticResource IMaoSecondaryTextStyle}" /></StackPanel>
        </InfoBar>
        <Button Grid.Row="2" Content="诊断工具" HorizontalAlignment="Left"><Button.Flyout><Flyout><ScrollViewer MaxHeight="300" Width="320" HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12">
                    <TextBlock Text="事件日志始终保存。诊断截图仅在手动启用后采集。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <ToggleSwitch x:Name="Diagnostics_CaptureToggle" Header="采集诊断截图" AutomationProperties.Name="采集诊断截图" Toggled="Diagnostics_CaptureToggle_Toggled" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="打开日志" Click="OpenLogs_Click" /><Button Content="复制诊断摘要" Click="CopySummary_Click" /><Button Content="打开崩溃报告" Click="OpenCrashes_Click" /></controls:WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Flyout></Button.Flyout></Button>
        <Border Grid.Row="3" Style="{StaticResource IMaoCardStyle}" Padding="14" MinHeight="80">
            <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="实时事件" Style="{StaticResource IMaoSectionTitleStyle}" /><ListView Grid.Row="1" x:Name="Diagnostics_LogList" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="0,5" FontSize="14" /></DataTemplate></ListView.ItemTemplate></ListView></Grid>
        </Border>
    </Grid>
</Page>
