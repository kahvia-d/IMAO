<Page x:Class="IMao_WinUI.Views.FunctionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:helpers="using:IMao_WinUI.Helpers">
    <Page.Resources>
        <helpers:RouteKindIconConverter x:Key="RouteKindIcon" />
        <helpers:BoolToVisibilityConverter x:Key="FlagToVisibility" />
    </Page.Resources>
    <StackPanel x:Name="ContentArea" Spacing="18" Padding="0,4,0,20">
        <!-- 顶部寰宇星图路线工作台标题栏 -->
        <StackPanel Spacing="4">
            <TextBlock Text="AETHERIA ROUTE STUDIO // 星图航线规划与合集整理" Style="{StaticResource IMaoEyebrowStyle}" />
            <TextBlock Text="路线" Style="{StaticResource IMaoPageTitleStyle}" />
            <TextBlock Text="管理本地路线合集、拖拽排序与导入导出，或查阅游戏内大地图选点与手绘操作。" Style="{StaticResource IMaoSecondaryTextStyle}" />
        </StackPanel>

        <InfoBar x:Name="AutoRouteMessage" IsOpen="False" IsClosable="True" />

        <ContentControl x:Name="AutoRouteActions" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="18">
                <!-- 01 路线列表与合集工作台（核心高频工作区前置） -->
                <Border Style="{StaticResource IMaoHeroCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="01 // ROUTE COLLECTIONS &amp; SAVED LIST · 路线合集与列表工作台" Style="{StaticResource IMaoEyebrowStyle}" />
                            <TextBlock Text="01  路线列表" Style="{StaticResource IMaoSectionTitleStyle}" />
                            <TextBlock Text="合集把路线分开放。切换合集就是决定「之后保存的路线放进哪一格」——游戏里保存的自动路线和手绘路线，都进当前合集。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 合集切换条与合集管理操作 -->
                        <Border Style="{StaticResource IMaoSubCardStyle}">
                            <StackPanel Spacing="10">
                                <controls:WrapPanel x:Name="RouteCollectionChips" HorizontalSpacing="8" VerticalSpacing="8" />
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button x:Name="RouteCollectionNew" Content="新建合集" Click="RouteCollectionNew_Click" />
                                    <Button x:Name="RouteCollectionRename" Content="重命名合集" Click="RouteCollectionRename_Click" />
                                    <Button x:Name="RouteCollectionDelete" Content="删除合集" Click="RouteCollectionDelete_Click" />
                                </controls:WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 当前活动路线遥测摘要 -->
                        <Border Style="{StaticResource IMaoSubCardStyle}" BorderBrush="{StaticResource IMaoCyanBorderBrush}" Padding="14,10">
                            <TextBlock x:Name="AutoRouteListSummary" Style="{StaticResource IMaoBodyTextStyle}" Foreground="{StaticResource IMaoCyanBrush}" TextWrapping="Wrap" />
                        </Border>

                        <!-- 批量操作工具条 -->
                        <StackPanel x:Name="RouteBatchBar" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="RouteBatchSummary" Style="{StaticResource IMaoSecondaryTextStyle}" Foreground="{StaticResource IMaoAccentBrush}" TextWrapping="Wrap" />
                            <Grid x:Name="RouteBatchActions" ColumnSpacing="8" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="全选" Click="RouteBatchSelectAll_Click" />
                                <Button Grid.Column="1" Content="导出所选" Click="RouteBatchExport_Click" />
                                <Button Grid.Column="2" Content="移动到合集" Click="RouteBatchMove_Click" />
                                <Button Grid.Column="3" Content="删除所选" Click="RouteBatchDelete_Click" />
                                <Button Grid.Column="4" Content="退出批量" Click="RouteBatchExit_Click" />
                            </Grid>
                        </StackPanel>

                        <!-- 路线列表与窗口内指针拖拽排序画布 -->
                        <Grid x:Name="RouteSortSurface">
                            <ListView x:Name="AutoRouteSavedRoutes" MaxHeight="420" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                                <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4" Padding="0,6">
                                            <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding Selected, Mode=TwoWay}" Click="RouteRowCheck_Click"
                                                      FontSize="16" FontWeight="SemiBold" Visibility="{Binding Batch, Converter={StaticResource FlagToVisibility}}" />
                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource IMaoTextBrush}"
                                                       TextWrapping="Wrap" Visibility="{Binding Batch, Converter={StaticResource FlagToVisibility}, ConverterParameter=invert}" />
                                            <TextBlock Text="{Binding DetailLabel}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Kinds, Converter={StaticResource RouteKindIcon}, ConverterParameter=empty}" FontSize="13"
                                                       TextWrapping="Wrap" Foreground="{StaticResource IMaoSecondaryTextBrush}"
                                                       Visibility="{Binding Kinds, Converter={StaticResource RouteKindIcon}, ConverterParameter=none}" />
                                            <ItemsControl ItemsSource="{Binding Kinds}" Visibility="{Binding Kinds, Converter={StaticResource RouteKindIcon}, ConverterParameter=any}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Image Source="{Binding IconPath, Converter={StaticResource RouteKindIcon}, ConverterParameter=icon}"
                                                                   Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="RouteDragHighlight" Background="#26E5C17B" BorderBrush="#FFE5C17B" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" />
                                <Border x:Name="RouteDragInsertion" Background="#FFF4EFE6" Height="4" CornerRadius="2" Visibility="Collapsed" />
                                <Border x:Name="RouteDragHint" Background="#F2101622" BorderBrush="#FFE5C17B" BorderThickness="1" CornerRadius="6" Padding="10,4" Visibility="Collapsed">
                                    <TextBlock x:Name="RouteDragHintText" Foreground="#FFE5C17B" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Canvas>
                        </Grid>

                        <TextBlock x:Name="AutoRouteEmptyHint"
                                   Text="还没有保存的路线。选好点生成预览后，在游戏内工具台里保存；也可以直接在大地图上手绘一条。"
                                   Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />

                        <!-- 路线底部核心操作行（保持 Auto 五列不截断文字） -->
                        <Grid x:Name="RouteActions" ColumnSpacing="8" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="刷新列表" Tag="list" Click="AutoRouteAction_Click" />
                            <Button Grid.Column="1" x:Name="AutoRouteDelete" Content="删除所选路线" Click="AutoRouteDelete_Click" />
                            <Button Grid.Column="2" Content="批量操作" Click="RouteBatchEnter_Click" />
                            <Button Grid.Column="3" Content="导入路线包" Click="RouteImport_Click" />
                            <Button Grid.Column="4" Content="导出当前合集" Click="RouteExportCollection_Click" />
                        </Grid>

                        <TextBlock Text="开始指引、选点、手绘都在游戏内大地图的「路径自动规划」面板里做，那里点一条路线就开始指引。这一页负责整理：切换合集、改名、删除、导入导出。删除只移除路线文件，点位的完成记录仍然保留。"
                                   Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 02 游戏内路线与手绘操作速查（结构化分栏卡片） -->
                <Border Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="02 // IN-GAME OPERATION MANUAL · 游戏内大地图路线操作速查" Style="{StaticResource IMaoEyebrowStyle}" />
                            <TextBlock Text="02  路线怎么操作" Style="{StaticResource IMaoSectionTitleStyle}" />
                            <TextBlock Text="选点画布就是游戏的大地图，下面这些全部在游戏里做，两种操作方式都能用：" Style="{StaticResource IMaoBodyTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource IMaoSubCardStyle}" BorderBrush="{StaticResource IMaoAccentBorderBrush}">
                            <TextBlock Text="· 键鼠：打开大地图，点底部中央那个圆形按钮（浅蓝描边的小圆）进入「地图工具台 → 路径自动规划」。&#x0a;· 手柄：打开大地图后按 LB，进入同一个工具台；按 RB 是点位助手（看攻略、完成点位），与路线分工不同。"
                                       Style="{StaticResource IMaoBodyTextStyle}" TextWrapping="Wrap" />
                        </Border>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource IMaoSubCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="STEP 01 · 大地图选点" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{StaticResource IMaoAccentBrush}" />
                                    <TextBlock Text="选点：单点选择 · 矩形框选 · 自由套索 · 加入当前视野 · 指定起点。框选和套索用鼠标拖动画，Shift + 左键拖拽是临时框选，Esc 取消还没提交的选区；最多 500 个目标，点过的点再点一次就移除。"
                                               Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource IMaoSubCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="STEP 02 · 成线与预览" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{StaticResource IMaoCyanBrush}" />
                                    <TextBlock Text="成线：生成预览看清访问顺序，再点开始指引。按平面距离排列，不代表可通行路径，也不含爬升或绕行距离；新预览不会顶掉正在走的路线。"
                                               Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource IMaoSubCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="STEP 03 · 实时导航与刷怪采集" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{StaticResource IMaoAccentBrush}" />
                                    <TextBlock Text="导航：程序画实线指向当前目标；到了就确认完成，不想去就跳过（可撤销）。偏离路线后可以重新规划或让实时规划自己重排。走怪点/采集物路线时，打开「刷怪采集」就能在目标附近自动标记，这个开关记在路线自己身上。"
                                               Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource IMaoSubCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="STEP 04 · 自由手绘路线" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{StaticResource IMaoCyanBrush}" />
                                    <TextBlock Text="手绘：单击空白新增自由点，点击可见点位加入画布；从一个点按住左键拖到另一个点建立或修改路线方向。悬停点位后连续按两次退格键可移除，Ctrl+Z 撤销，Esc 结束编辑并保留待保存草稿。已有手绘路线可在游戏内路线列表选中后点击顶部「修改路线」。"
                                               Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="暂停只停指引，退出导航才结束这次活动路线；删除路线不影响点位的完成记录。"
                                   Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ContentControl>

        <Button Content="查看操作帮助" Click="UsageGuide_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
    </StackPanel>
</Page>
