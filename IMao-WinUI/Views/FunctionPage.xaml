<Page x:Class="IMao_WinUI.Views.FunctionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:helpers="using:IMao_WinUI.Helpers">
    <Page.Resources>
        <helpers:RouteKindIconConverter x:Key="RouteKindIcon" />
        <helpers:BoolToVisibilityConverter x:Key="FlagToVisibility" />
    </Page.Resources>
    <StackPanel x:Name="ContentArea" Spacing="22">
        <StackPanel Spacing="5"><TextBlock Text="ROUTE STUDIO" Style="{StaticResource IMaoEyebrowStyle}" /><TextBlock Text="路线" Style="{StaticResource IMaoPageTitleStyle}" /><TextBlock Text="路线怎么操作，以及你保存过哪些路线。" Style="{StaticResource IMaoSecondaryTextStyle}" /></StackPanel>
        <InfoBar x:Name="AutoRouteMessage" IsOpen="False" IsClosable="True" />
        <ContentControl x:Name="AutoRouteActions" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="18">
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="01  路线怎么操作" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock Text="选点画布就是游戏的大地图，下面这些全部在游戏里做，两种操作方式都能用：" Style="{StaticResource IMaoBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="· 键鼠：打开大地图，点底部中央那个圆形按钮（浅蓝描边的小圆）进入「地图工具台 → 路径自动规划」。&#x0a;· 手柄：打开大地图后按 LB，进入同一个工具台；按 RB 是点位助手（看攻略、完成点位），与路线分工不同。" Style="{StaticResource IMaoBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="选点：单点选择 · 矩形框选 · 自由套索 · 加入当前视野 · 指定起点。框选和套索用鼠标拖动画，Shift + 左键拖拽是临时框选，Esc 取消还没提交的选区；最多 500 个目标，点过的点再点一次就移除。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="成线：生成预览看清访问顺序，再点开始指引。按平面距离排列，不代表可通行路径，也不含爬升或绕行距离；新预览不会顶掉正在走的路线。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="导航：程序画实线指向当前目标；到了就确认完成，不想去就跳过（可撤销）。偏离路线后可以重新规划或让实时规划自己重排。走怪点/采集物路线时，打开「刷怪采集」就能在目标附近自动标记，这个开关记在路线自己身上。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="手绘：在大地图上点一下记一个点，第一个点是起点、最后一个是终点；点在点位上就连到那个点位，点在空地上生成带编号的标记。Esc 结束，画好的点会留着等你保存。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="暂停只停指引，退出导航才结束这次活动路线；删除路线不影响点位的完成记录。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="02  路线列表" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock Text="合集把路线分开放。切换合集就是决定「之后保存的路线放进哪一格」——游戏里保存的自动路线和手绘路线，都进当前合集。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <controls:WrapPanel x:Name="RouteCollectionChips" HorizontalSpacing="8" VerticalSpacing="8" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button x:Name="RouteCollectionNew" Content="新建合集" Click="RouteCollectionNew_Click" />
                        <Button x:Name="RouteCollectionRename" Content="重命名合集" Click="RouteCollectionRename_Click" />
                        <Button x:Name="RouteCollectionDelete" Content="删除合集" Click="RouteCollectionDelete_Click" />
                    </controls:WrapPanel>
                    <TextBlock x:Name="AutoRouteListSummary" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <StackPanel x:Name="RouteBatchBar" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="RouteBatchSummary" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button Content="全选" Click="RouteBatchSelectAll_Click" />
                            <Button Content="导出所选" Click="RouteBatchExport_Click" />
                            <Button Content="移动到…" Click="RouteBatchMove_Click" />
                            <Button Content="删除所选" Click="RouteBatchDelete_Click" />
                            <Button Content="退出批量" Click="RouteBatchExit_Click" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <ListView x:Name="AutoRouteSavedRoutes" MaxHeight="420" SelectionMode="Single" HorizontalContentAlignment="Stretch" SelectionChanged="AutoRouteSavedRoutes_SelectionChanged">
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Spacing="4" Padding="0,4">
                                <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding Selected, Mode=TwoWay}" Click="RouteRowCheck_Click" FontSize="17" FontWeight="SemiBold" Visibility="{Binding Batch, Converter={StaticResource FlagToVisibility}}" />
                                <TextBlock Text="{Binding DisplayLabel}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding Batch, Converter={StaticResource FlagToVisibility}, ConverterParameter=invert}" />
                                <TextBlock Text="{Binding DetailLabel}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Kinds, Converter={StaticResource RouteKindIcon}, ConverterParameter=empty}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding Kinds}" Visibility="{Binding Kinds, Converter={StaticResource RouteKindIcon}, ConverterParameter=hasIcon}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Image Source="{Binding IconPath, Converter={StaticResource RouteKindIcon}, ConverterParameter=icon}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="AutoRouteEmptyHint" Text="还没有保存的路线。选好点生成预览后，在游戏内工具台里保存；也可以直接在大地图上手绘一条。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button x:Name="AutoRouteSwitch" Content="开始指引这条路线" Click="AutoRouteSwitch_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                        <Button Content="刷新列表" Tag="list" Click="AutoRouteAction_Click" />
                        <Button x:Name="AutoRouteDelete" Content="删除所选路线" Click="AutoRouteDelete_Click" />
                        <Button Content="批量…" Click="RouteBatchEnter_Click" />
                        <Button Content="导入…" Click="RouteImport_Click" />
                        <Button Content="导出当前合集…" Click="RouteExportCollection_Click" />
                    </controls:WrapPanel>
                    <TextBlock Text="开始指引会切换到选中的那条并立刻导航，和在游戏内列表里点它一下是同一件事。删除只移除路线文件，点位的完成记录仍然保留。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ContentControl>
        <Button Content="查看操作帮助" Click="UsageGuide_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
    </StackPanel>
</Page>
