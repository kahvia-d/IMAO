<Page x:Class="IMao_WinUI.Views.FunctionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel x:Name="ContentArea" Spacing="22">
        <StackPanel Spacing="5"><TextBlock Text="ROUTE STUDIO" Style="{StaticResource IMaoEyebrowStyle}" /><TextBlock Text="路线" Style="{StaticResource IMaoPageTitleStyle}" /><TextBlock Text="选择目标，预览顺序，再开始探索。" Style="{StaticResource IMaoSecondaryTextStyle}" /></StackPanel>
        <InfoBar x:Name="AutoRouteMessage" IsOpen="False" IsClosable="True" />
        <ContentControl x:Name="AutoRouteActions" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="18">
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="01  选择目标" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock Text="打开游戏大地图后开始选点。筛选决定可见点位，选点决定这次路线要去哪里。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button Content="开始选点" Tag="new" Click="AutoRouteAction_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                        <Button Content="结束选点" Tag="end" Click="AutoRouteAction_Click" />
                        <Button Content="加入可见点" Tag="addVisible" Click="AutoRouteAction_Click" />
                        <Button Content="撤销" Tag="undo" Click="AutoRouteAction_Click" />
                        <Button Content="清空" Tag="clear" Click="AutoRouteAction_Click" />
                    </controls:WrapPanel>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button Content="移动地图" Tag="pan" Click="AutoRouteTool_Click" /><Button Content="矩形框选" Tag="box" Click="AutoRouteTool_Click" /><Button Content="自由套索" Tag="lasso" Click="AutoRouteTool_Click" /><Button Content="指定起点" Tag="start" Click="AutoRouteTool_Click" />
                    </controls:WrapPanel>
                    <TextBlock x:Name="AutoRouteSelectionSummary" Style="{StaticResource IMaoBodyTextStyle}" />
                    <TextBlock x:Name="AutoRouteStartSummary" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="查看已选点位">
                        <ListView x:Name="AutoRouteSelectedStops" MaxHeight="250" SelectionMode="None" HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ListLabel}" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="移除" Tag="{Binding Key}" Click="AutoRouteRemove_Click" /></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="02  预览路线" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock x:Name="AutoRoutePreviewSummary" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <ProgressBar x:Name="AutoRouteProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button x:Name="AutoRouteGenerate" Content="生成路线预览" Tag="generate" Click="AutoRouteAction_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" /><Button x:Name="AutoRouteActivate" Content="开始导航" Tag="activate" Click="AutoRouteAction_Click" /></controls:WrapPanel>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="查看预览顺序"><ListView x:Name="AutoRoutePreviewStops" MaxHeight="250" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding ListLabel}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate></ListView></Expander>
                    <TextBlock Text="按平面距离排列目标；不代表可通行路径，也不包含爬升或绕行距离。预览不会替换当前导航。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="03  当前导航" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock x:Name="AutoRouteActiveSummary" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <Border Background="{StaticResource IMaoRaisedSurfaceBrush}" CornerRadius="8" Padding="14"><TextBlock x:Name="AutoRouteCurrentTarget" Style="{StaticResource IMaoBodyTextStyle}" /></Border>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button x:Name="AutoRouteGuide" Content="查看当前目标攻略" Tag="guide" Click="AutoRouteAction_Click" /><Button Content="完成当前目标" Tag="complete" Click="AutoRouteAction_Click" /><Button Content="跳过当前目标" Tag="skip" Click="AutoRouteAction_Click" /></controls:WrapPanel>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="暂停" Tag="pause" Click="AutoRouteAction_Click" /><Button Content="继续" Tag="resume" Click="AutoRouteAction_Click" /><Button Content="撤销跳过" Tag="undoSkip" Click="AutoRouteAction_Click" /><Button Content="重新规划" Tag="replan" Click="AutoRouteAction_Click" /><Button x:Name="AutoRouteStop" Content="停止导航" Tag="stop" Click="AutoRouteAction_Click" /></controls:WrapPanel>
                    <ToggleSwitch x:Name="AutoReplanToggle" Header="实时规划剩余路线" Toggled="AutoReplan_Toggled" />
                    <TextBlock x:Name="AutoReplanStateText" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <TextBlock Text="开启后根据当前位置调整剩余目标；靠近当前目标时保持稳定，暂停或选点时停止调整。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="查看活动路线"><ListView x:Name="AutoRouteActiveStops" MaxHeight="250" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding ListLabel}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate></ListView></Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="路线收藏" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBox x:Name="AutoRouteName" Header="路线名称" PlaceholderText="给这次探索起个名字" MaxWidth="450" HorizontalAlignment="Stretch" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="保存预览路线" Tag="preview" Click="AutoRouteSave_Click" /><Button Content="保存活动路线" Tag="active" Click="AutoRouteSave_Click" /></controls:WrapPanel>
                    <ComboBox x:Name="AutoRouteSavedRoutes" Header="已保存的路线" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="载入路线" Click="AutoRouteLoad_Click" /><Button Content="刷新列表" Tag="list" Click="AutoRouteAction_Click" /><Button Content="删除所选路线" Click="AutoRouteDelete_Click" /></controls:WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ContentControl>
        <Expander Header="手绘路线" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="14">
                <TextBlock Text="记录地图上的线段，保留你自己的探索路径。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <TextBlock x:Name="ManualRouteKeyDisplay" Foreground="{StaticResource IMaoAccentBrush}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="ManualRouteDescription" Style="{StaticResource IMaoBodyTextStyle}" />
                <TextBox x:Name="TextBox_SavedRouteJsonName" Header="手绘路线名称" MaxWidth="450" HorizontalAlignment="Stretch" />
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="设置保存名称" Click="Button_SavedRouteJsonName_Click" /><Button Content="打开路线目录" Click="Button_OpenRoutesFolder_Click" /><Button Content="加载全部手绘路线" Click="Button_LoadRoutesData_Click" /></controls:WrapPanel>
                <ComboBox x:Name="ComboBox_RouteDataName" Header="已保存的手绘路线" HorizontalAlignment="Stretch" DropDownOpened="ComboBox_RouteDataName_DropDownOpened" />
                <Button Content="加载所选手绘路线" Click="Button_LoadOneRouteData" />
            </StackPanel>
        </Expander>
        <Button Content="查看操作帮助" Click="UsageGuide_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
    </StackPanel>
</Page>
