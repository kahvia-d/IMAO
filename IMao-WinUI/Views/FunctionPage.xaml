<Page x:Class="IMao_WinUI.Views.FunctionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel x:Name="ContentArea" Spacing="22">
        <StackPanel Spacing="5"><TextBlock Text="ROUTE STUDIO" Style="{StaticResource IMaoEyebrowStyle}" /><TextBlock Text="路线" Style="{StaticResource IMaoPageTitleStyle}" /><TextBlock Text="选点、生成、导航都在游戏里，这里负责看清和管好这条路线。" Style="{StaticResource IMaoSecondaryTextStyle}" /></StackPanel>
        <InfoBar x:Name="AutoRouteMessage" IsOpen="False" IsClosable="True" />
        <ContentControl x:Name="AutoRouteActions" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="18">
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="01  在哪里操作" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock Text="路线的选点画布就是游戏的大地图。打开大地图后按 LB 进入「地图工具台 → 路径自动规划」，下面的操作都在那里：矩形框选 · 自由套索 · 单点选择 · 加入当前视野 · 指定起点 · 生成预览 · 开始指引 · 重新规划 · 刷怪采集 · 路线列表（切换与保存） · 手绘路线（点击大地图记点，Esc 结束）。" Style="{StaticResource IMaoBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="大地图按 RB 是点位助手（看攻略、完成点位），与路线分工不同。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="这一页只留下不需要地图也能做的事：看清当前导航、生成/开始一条已有选点的路线、翻看已保存的路线。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="02  当前导航" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock x:Name="AutoRouteActiveSummary" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <Border Background="{StaticResource IMaoRaisedSurfaceBrush}" CornerRadius="8" Padding="14"><TextBlock x:Name="AutoRouteCurrentTarget" Style="{StaticResource IMaoBodyTextStyle}" /></Border>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button x:Name="AutoRouteGuide" Content="查看当前目标攻略" Tag="guide" Click="AutoRouteAction_Click" /><Button Content="完成当前目标" Tag="complete" Click="AutoRouteAction_Click" /><Button Content="跳过当前目标" Tag="skip" Click="AutoRouteAction_Click" /></controls:WrapPanel>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="暂停" Tag="pause" Click="AutoRouteAction_Click" /><Button Content="继续" Tag="resume" Click="AutoRouteAction_Click" /><Button Content="撤销跳过" Tag="undoSkip" Click="AutoRouteAction_Click" /><Button x:Name="AutoRouteStop" Content="停止导航" Tag="stop" Click="AutoRouteAction_Click" /></controls:WrapPanel>
                    <TextBlock Text="完成当前目标不会检查你站在哪里：它是「这个点我已经自己处理掉了」。跳过只影响这条路线，可以撤销；停止导航会结束这次活动选择，点位完成记录保留。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="AutoReplanToggle" Header="实时规划剩余路线" Toggled="AutoReplan_Toggled" />
                    <TextBlock x:Name="AutoReplanStateText" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <TextBlock Text="开启后根据当前位置调整剩余目标；靠近当前目标时保持稳定，暂停或选点时停止调整。它需要游戏在运行并且定位可靠，在游戏内工具栏里也能随时切换。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="查看活动路线"><ListView x:Name="AutoRouteActiveStops" MaxHeight="250" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding ListLabel}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate></ListView></Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="03  路线预览" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock Text="如果选点已经完成，可以在这里生成访问顺序并开始导航；预览不会替换当前导航，直到你点击开始。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AutoRoutePreviewState" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button x:Name="AutoRouteGenerate" Content="生成路线预览" Tag="generate" Click="AutoRouteAction_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" /><Button x:Name="AutoRouteActivate" Content="开始导航" Tag="activate" Click="AutoRouteAction_Click" /></controls:WrapPanel>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="查看预览顺序"><ListView x:Name="AutoRoutePreviewStops" MaxHeight="250" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding ListLabel}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate></ListView></Expander>
                    <TextBlock Text="按平面距离排列目标；不代表可通行路径，也不包含爬升或绕行距离。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="04  已保存的路线" Style="{StaticResource IMaoSectionTitleStyle}" />
                    <TextBlock Text="切到哪一条、开始哪一条，在游戏内「路径自动规划 → 路线列表」里操作：那里点一行就直接应用并开始指引。这里只是把保存过的路线摊开给你看，顺带删除。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <ListView x:Name="AutoRouteSavedRoutes" MaxHeight="320" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="2"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /><TextBlock Text="{Binding DetailLabel}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource IMaoSecondaryTextBrush}" /><TextBlock Text="{Binding KindLabel}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource IMaoSecondaryTextBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="刷新列表" Tag="list" Click="AutoRouteAction_Click" /><Button Content="删除所选路线" Click="AutoRouteDelete_Click" /></controls:WrapPanel>
                    <TextBlock Text="删除只会移除这条路线文件；如果它正在导航，也会退出导航。点位的完成记录仍然保留。" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ContentControl>
        <Button Content="查看操作帮助" Click="UsageGuide_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
    </StackPanel>
</Page>
