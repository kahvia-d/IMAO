<Page x:Class="IMao_WinUI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="16" Padding="0,2,0,20">
        <!-- 页面标题与分类切换栏 -->
        <StackPanel Spacing="12">
            <TextBlock Text="设置" Style="{StaticResource IMaoPageTitleStyle}" />

            <Border Style="{StaticResource IMaoSubCardStyle}" Padding="8,7">
                <controls:WrapPanel x:Name="SettingsCategoryBar" HorizontalSpacing="6" VerticalSpacing="6">
                    <Button x:Name="CategoryBtn_Sync" Content="记录本与云同步" Tag="sync" Click="SettingsCategory_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" Padding="14,7" />
                    <Button x:Name="CategoryBtn_Display" Content="捕获与叠加显示" Tag="display" Click="SettingsCategory_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Padding="14,7" />
                    <Button x:Name="CategoryBtn_Input" Content="快捷键与手柄" Tag="input" Click="SettingsCategory_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Padding="14,7" />
                    <Button x:Name="CategoryBtn_Updates" Content="版本与地图区域" Tag="updates" Click="SettingsCategory_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Padding="14,7" />
                    <Button x:Name="CategoryBtn_System" Content="数据目录与兼容" Tag="system" Click="SettingsCategory_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Padding="14,7" />
                </controls:WrapPanel>
            </Border>
        </StackPanel>

        <!-- ==================== 分区 1：记录本与库街区云同步 ==================== -->
        <StackPanel x:Name="SettingsGroup_Sync" Spacing="16" Visibility="Visible">
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- 左卡：本地点位记录本 -->
                <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="本地点位记录本" Style="{StaticResource IMaoSectionTitleStyle}" />
                            <TextBlock Text="地图仅显示当前选中的记录本；每个记录本可独立绑定一个库街区账号。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource IMaoSubCardStyle}">
                            <Grid x:Name="LocalAccountGrid" ColumnSpacing="14" RowSpacing="6" />
                        </Border>

                        <InfoBar x:Name="LocalAccountMessage" IsOpen="False" IsClosable="True" Visibility="Collapsed" />

                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button Content="新增" Click="LocalAccountCreate_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                            <Button Content="修改" Click="LocalAccountEdit_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button Content="删除" Click="LocalAccountDelete_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button x:Name="LocalAccountImportButton" Content="导入旧记录" Click="LocalAccountImport_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Visibility="Collapsed" />
                            <Button Content="导出体检" Click="LocalAccountDiagnostics_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button Content="打开目录" Click="OpenPoints_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                        </controls:WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 右卡：库街区点位进度同步 -->
                <Border Grid.Column="1" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="库街区点位进度同步" Style="{StaticResource IMaoSectionTitleStyle}" />
                            <TextBlock Text="通过浏览器扩展连接桌面端并将账号 ID 绑定至左侧记录本后即可双向同步。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource IMaoSubCardStyle}">
                            <TextBlock x:Name="KuroSyncLedger" TextWrapping="Wrap" Style="{StaticResource IMaoBodyTextStyle}" />
                        </Border>

                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                                <TextBlock Text="同步地图区域范围" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox x:Name="KuroSyncState" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="KuroSyncState_SelectionChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="自动同步" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="游戏内完成点位立即推送，并每 10 分钟自动补齐" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="KuroSyncAutoSync" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="KuroSyncAutoSync_Toggled" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示已同步数" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="KuroSyncShowSynced" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="KuroSyncShowSynced_Toggled" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示无差异区域" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="KuroSyncShowAll" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="KuroSyncShowAll_Toggled" />
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="KuroAutoSyncStatus" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />

                        <StackPanel x:Name="KuroSyncProgressPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock x:Name="KuroSyncProgressText" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                            <ProgressBar x:Name="KuroSyncProgressBar" />
                        </StackPanel>

                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Name="KuroSyncPreviewButton" Content="预览同步" Click="KuroSyncPreview_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                            <Button x:Name="KuroSyncApplyButton" Content="应用同步" Click="KuroSyncApply_Click" IsEnabled="False" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button Content="注册/修复浏览器桥接" Click="KuroBridgeRegister_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button Content="打开同步数据目录" Click="KuroSyncOpen_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button Content="断开库街区连接" Click="KuroSyncDisconnect_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                        </controls:WrapPanel>

                        <TextBlock x:Name="KuroBridgeStatus" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                        <InfoBar x:Name="KuroSyncMessage" IsOpen="False" IsClosable="True" />

                        <StackPanel x:Name="KuroSyncPlanPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="KuroSyncPlanSummary" TextWrapping="Wrap" />
                            <Grid x:Name="KuroSyncPlanGrid" ColumnSpacing="16" RowSpacing="4" />
                            <TextBlock x:Name="KuroSyncPlanFooter" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ==================== 分区 2：捕获与叠加显示 ==================== -->
        <StackPanel x:Name="SettingsGroup_Display" Spacing="16" Visibility="Collapsed">
            <ContentControl x:Name="RuntimeSettings" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左卡：地图显示与路线重排开关 -->
                    <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="地图显示与自动重排" Style="{StaticResource IMaoSectionTitleStyle}" Margin="0,0,0,2" />

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示小地图点位" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="Setting_MinMapShowItem" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="ToggleSwitch_MinMapShowItem" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示大地图点位" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="Setting_MapShowItem" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="ToggleSwitch_MapShowItem" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示已完成点位" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="Setting_SetVisibleSavedPoints" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="ToggleSwitch_SetVisibleSavedPoints" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="小地图状态条" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="ToggleSwitch_StatusBar" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="ToggleSwitch_StatusBar_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="大地图状态条" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="ToggleSwitch_MapStatusBar" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="ToggleSwitch_MapStatusBar_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="小地图状态球" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="ToggleSwitch_StatusBall" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="ToggleSwitch_StatusBall_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="偏离路线时自动重排剩余目标" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="AutomaticReplan" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="AutomaticReplan_Toggled" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 右卡：画面捕获、呈现与刷新率 -->
                    <Border Grid.Column="1" Style="{StaticResource IMaoCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="捕获、呈现与刷新率" Style="{StaticResource IMaoSectionTitleStyle}" Margin="0,0,0,2" />

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="205" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="画面捕获方式" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="停止探索后可切换" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboBox_CaptureMethod" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="CaptureMethod_SelectionChanged">
                                        <x:String>BitBlt</x:String>
                                        <x:String>Windows Graphics Capture</x:String>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="205" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="叠加层呈现方式" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="停止探索后可切换" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboBox_PresentMethod" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="PresentMethod_SelectionChanged">
                                        <x:String>分层窗口（默认）</x:String>
                                        <x:String>DirectComposition（可选）</x:String>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="小地图刷新间隔（毫秒）" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="范围 16 ~ 1000 ms" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    </StackPanel>
                                    <NumberBox x:Name="UpdateMinMapItemDataCycle" Grid.Column="1" Minimum="16" Maximum="1000" SmallChange="10"
                                               SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="UpdateMinMapItemDataCycle_ValueChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="大地图刷新间隔（毫秒）" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="范围 16 ~ 1000 ms" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    </StackPanel>
                                    <NumberBox x:Name="UpdateMapItemDataCycle" Grid.Column="1" Minimum="16" Maximum="1000" SmallChange="10"
                                               SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="UpdateMapItemDataCycle_ValueChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="GPU 加速（OCR 坐标识别）" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="使用 DirectML 分担 CPU 负担，重启软件后生效" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="OcrGpuAcceleration" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="OcrGpuAcceleration_Toggled" />
                                    </Grid>
                                    <TextBlock x:Name="OcrBackendState" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <InfoBar x:Name="OcrPerformanceMessage" IsOpen="False" IsClosable="True" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ContentControl>
            <Grid ColumnSpacing="16">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#E5C17B" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F2D494" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#C8A25A" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#E5C17B" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#F2D494" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#C8A25A" />
                </Grid.Resources>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="窗口与提示大小" Style="{StaticResource IMaoSectionTitleStyle}" />
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="小地图状态条" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MinimapStatusScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="MinimapStatusScaleSlider" Tag="MinimapStatus" AutomationProperties.Name="小地图状态条大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="大地图状态条" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MapStatusScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="MapStatusScaleSlider" Tag="MapStatus" AutomationProperties.Name="大地图状态条大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="工具栏入口与窗口" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ToolsScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="ToolsScaleSlider" Tag="Tools" AutomationProperties.Name="工具栏入口与窗口大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="攻略窗口" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GuideScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="GuideScaleSlider" Tag="Guide" AutomationProperties.Name="攻略窗口大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="操作与错误提示" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HintScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="HintScaleSlider" Tag="Hint" AutomationProperties.Name="操作与错误提示大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="地图标记与手绘大小" Style="{StaticResource IMaoSectionTitleStyle}" />
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="大地图标记" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MapMarkerScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="MapMarkerScaleSlider" Tag="MapMarker" AutomationProperties.Name="大地图标记大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="小地图标记" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MinimapMarkerScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="MinimapMarkerScaleSlider" Tag="MinimapMarker" AutomationProperties.Name="小地图标记大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="手绘选项栏" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HandPaletteScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="HandPaletteScaleSlider" Tag="HandPalette" AutomationProperties.Name="手绘选项栏大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="手绘节点编号" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HandNodeScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="HandNodeScaleSlider" Tag="HandNode" AutomationProperties.Name="手绘节点编号大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="小地图状态球" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusBallScaleLabel" Grid.Column="1" Text="100% · 自动适配" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="StatusBallScaleSlider" Tag="StatusBall" AutomationProperties.Name="小地图状态球大小" Minimum="50" Maximum="200" StepFrequency="1" Value="100" ValueChanged="OverlayScale_ValueChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            <InfoBar x:Name="OverlayScaleMessage" IsOpen="False" IsClosable="True" />
            <InfoBar x:Name="RuntimeMessage" IsOpen="False" IsClosable="True" Visibility="Collapsed" />
        </StackPanel>

        <!-- ==================== 分区 3：快捷键与手柄 ==================== -->
        <StackPanel x:Name="SettingsGroup_Input" Spacing="16" Visibility="Collapsed">
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- 左卡：键盘快捷键 -->
                <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="键盘快捷键" Style="{StaticResource IMaoSectionTitleStyle}" />
                            <TextBlock Text="修改后点击下方「保存快捷键」生效（M、F10 为保留键不可分配）。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="12,8">
                            <TextBlock x:Name="CurrentBindings" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </Border>

                        <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="完成点位" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox x:Name="NearestCompletionKey" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="打开 / 关闭攻略" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox x:Name="CurrentTargetGuideKey" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="开始 / 停止探索" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox x:Name="ToggleEnabledKey" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="记录手绘线段端点" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox x:Name="ManualRouteKey" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="攻略内长按跳过目标" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox x:Name="GuideSkipKey" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="攻略上一张" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox x:Name="GuidePreviousImageKey" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="攻略下一张" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox x:Name="GuideNextImageKey" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10" Margin="0,4,0,0">
                            <Button x:Name="SaveShortcuts" Content="保存快捷键" Click="SaveShortcuts_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                            <Button x:Name="ResetShortcuts" Content="恢复默认" Click="ResetShortcuts_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                        </controls:WrapPanel>
                        <InfoBar x:Name="ShortcutMessage" IsOpen="False" IsClosable="True" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 右栏：上「触发范围与聚合」 + 下「手柄设置」 -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource IMaoCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="触发范围与图标聚合" Style="{StaticResource IMaoSectionTitleStyle}" />

                            <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="完成点位触发范围（像素）" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="默认 15" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    </StackPanel>
                                    <NumberBox x:Name="CompletionRangePixels" Grid.Column="1" Minimum="5" Maximum="120" SmallChange="5" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="CompletionRange_ValueChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="查看攻略触发范围（像素）" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="默认 15" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    </StackPanel>
                                    <NumberBox x:Name="GuideRangePixels" Grid.Column="1" Minimum="5" Maximum="120" SmallChange="5" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="GuideRange_ValueChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="刷怪采集自动标记范围（像素）" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="默认 30" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    </StackPanel>
                                    <NumberBox x:Name="FarmRangePixels" Grid.Column="1" Minimum="5" Maximum="120" SmallChange="5" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="FarmRange_ValueChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="图标合并重叠阈值（%）" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="1 接触即合并 · 50 半重叠 · 100 完全重叠" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                    </StackPanel>
                                    <NumberBox x:Name="MarkerMergeOverlapPercent" Grid.Column="1" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="MarkerMergeOverlap_ValueChanged" />
                                </Grid>
                            </Border>

                            <InfoBar x:Name="RangeMessage" IsOpen="False" IsClosable="True" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource IMaoCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="手柄设置" Style="{StaticResource IMaoSectionTitleStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="刷新设备" Click="RefreshGamepads_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" VerticalAlignment="Center" />
                            </Grid>

                            <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="启用手柄操作" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="GamepadEnabled" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="GamepadEnabled_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="使用的手柄设备" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox x:Name="GamepadDevice" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="GamepadDevice_SelectionChanged">
                                        <x:String>自动选择首个连接的手柄</x:String><x:String>手柄 1</x:String><x:String>手柄 2</x:String><x:String>手柄 3</x:String><x:String>手柄 4</x:String>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSettingRowStyle}" Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="按键提示布局" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox x:Name="GamepadLayout" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="GamepadLayout_SelectionChanged">
                                        <x:String>自动识别</x:String><x:String>Xbox</x:String><x:String>PlayStation</x:String>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource IMaoSubCardStyle}" Padding="12,8">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="GamepadStatus" Style="{StaticResource IMaoBodyTextStyle}" />
                                    <!-- 冗长的手柄教程已归入左侧「帮助文档」，此处隐藏兼容字段 -->
                                    <TextBlock x:Name="GamepadInstructions" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <InfoBar x:Name="GamepadMessage" IsOpen="False" IsClosable="True" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ==================== 分区 4：版本与地图区域 ==================== -->
        <StackPanel x:Name="SettingsGroup_Updates" Spacing="16" Visibility="Collapsed">
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- 左上卡：版本与地图资源更新 -->
                <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="版本与地图资源" Style="{StaticResource IMaoSectionTitleStyle}" />

                        <Border Style="{StaticResource IMaoSubCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="UpdateVersions" Style="{StaticResource IMaoBodyTextStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Name="UpdateLastChecked" Style="{StaticResource IMaoSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IMaoSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启动后检查更新" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="每天最多自动检查一次，由你决定是否安装" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutomaticUpdateCheck" Grid.Column="1" Style="{StaticResource IMaoCompactToggleStyle}" Toggled="AutomaticUpdateCheck_Toggled" />
                            </Grid>
                        </Border>

                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="CheckUpdates_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button x:Name="InstallResourcesButton" Content="下载并安装地图资源" Click="InstallResources_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                            <Button x:Name="DownloadProgramButton" Content="下载新版程序" Click="DownloadProgram_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button x:Name="RestartProgramButton" Content="退出并更新" Click="RestartProgram_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                            <Button x:Name="ImportResourcesButton" Content="导入离线包" Click="ImportResources_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button x:Name="RollbackResourcesButton" Content="回退上一版" Click="RollbackResources_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button x:Name="RollbackProgramButton" Content="回退程序版本" Click="RollbackProgram_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button x:Name="RepairUpdateStateButton" Content="修复更新状态" Click="RepairUpdateState_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="SwitchDownloadSourceButton" Content="改用 GitHub 并重新检查" Click="SwitchDownloadSource_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="CancelUpdateButton" Content="取消" Click="CancelUpdate_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                        </controls:WrapPanel>

                        <TextBlock x:Name="ResourceUpdateSource" Style="{StaticResource IMaoBodyTextStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="ResourceUpdateProgressText" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        <ProgressBar x:Name="ResourceUpdateProgress" Minimum="0" Maximum="100" Height="8" CornerRadius="4" Visibility="Collapsed" />
                        <TextBlock x:Name="ResourceUpdateNotes" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        <InfoBar x:Name="ResourceUpdateMessage" IsOpen="True" IsClosable="False" />
                    </StackPanel>
                </Border>

                <!-- 右上卡：下载源管理 -->
                <Border Grid.Column="1" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="下载源管理" Style="{StaticResource IMaoSectionTitleStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border x:Name="GitHubSourceChip" CornerRadius="6" Padding="8,4" Background="{StaticResource IMaoRaisedSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource IMaoBorderBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontSize="11" Glyph="&#xE774;" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="GitHub" FontSize="12" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                                        <FontIcon x:Name="GitHubSourceMark" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock x:Name="GitHubSourceStatus" Text="未检测" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MirrorSourceChip" CornerRadius="6" Padding="8,4" Background="{StaticResource IMaoRaisedSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource IMaoBorderBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontSize="11" Glyph="&#xE896;" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Mirror酱" FontSize="12" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                                        <FontIcon x:Name="MirrorSourceMark" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MirrorSourceStatus" Text="未填 CDK" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="RefreshConnectivityButton" Click="RefreshConnectivity_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Padding="8,5" ToolTipService.ToolTip="重新检测各下载源的连通性">
                                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IMaoSubCardStyle}">
                                <RadioButton x:Name="SourceGitHubOption" GroupName="DownloadSourceOption" MinWidth="0" Margin="0" VerticalAlignment="Top" Checked="DownloadSourceOption_Checked">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="GitHub 官方源" FontWeight="SemiBold" />
                                        <TextBlock Text="免费直连" Style="{StaticResource IMaoSecondaryTextStyle}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource IMaoSubCardStyle}">
                                <RadioButton x:Name="SourceMirrorOption" GroupName="DownloadSourceOption" MinWidth="0" Margin="0" VerticalAlignment="Top" Checked="DownloadSourceOption_Checked">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Mirror酱 高速源" FontWeight="SemiBold" />
                                        <TextBlock Text="国内高速节点，需配置 CDK" Style="{StaticResource IMaoSecondaryTextStyle}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </Grid>

                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <PasswordBox x:Name="MirrorChyanCdkBox" Width="220" PlaceholderText="粘贴 Mirror酱 CDK" PasswordRevealMode="Peek" />
                            <Button x:Name="SaveCdkButton" Content="保存 CDK" Click="SaveCdk_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button x:Name="ClearCdkButton" Content="清除 CDK" Click="ClearCdk_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button x:Name="OpenMirrorChyanButton" Content="前往 Mirror酱" Click="OpenMirrorChyan_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                        </controls:WrapPanel>
                        <TextBlock x:Name="MirrorChyanCdkState" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        <TextBlock x:Name="ConnectivitySummary" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 下卡：地图区域特征包管理 -->
            <Border Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="地图区域管理" Style="{StaticResource IMaoSectionTitleStyle}" />
                            <TextBlock Text="按国家分组管理区域定位包；关闭不需要的区域可减少内存占用。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource IMaoSubCardStyle}" VerticalAlignment="Top" Padding="12,8">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="RegionSummary" Style="{StaticResource IMaoBodyTextStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Name="RegionCoreState" Style="{StaticResource IMaoSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="RegionList" Spacing="6" />
                    <TextBlock x:Name="RegionHint" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <ProgressBar x:Name="RegionProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="RegionProgressText" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <InfoBar x:Name="RegionMessage" IsOpen="False" IsClosable="True" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ==================== 分区 5：数据目录与系统兼容 ==================== -->
        <StackPanel x:Name="SettingsGroup_System" Spacing="16" Visibility="Collapsed">
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="本地进度与路线目录" Style="{StaticResource IMaoSectionTitleStyle}" />
                            <TextBlock Text="点位完成记录与路线合集均保存在本机目录，可随时备份或查阅。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>
                        <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                            <Button Content="点位进度目录" Click="OpenPoints_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                            <Button Content="路线文件目录" Click="OpenRoutes_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                        </controls:WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource IMaoCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Windows 窗口兼容设置" Style="{StaticResource IMaoSectionTitleStyle}" />
                            <TextBlock Text="使用 BitBlt 捕获出现黑屏或画面静止时，可应用窗口兼容设置。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>
                        <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                            <Button Content="应用窗口兼容设置" Click="ApplyWindowCompatibility_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                            <Button Content="恢复图形默认设置" Click="RestoreWindowCompatibility_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                        </controls:WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
</Page>
