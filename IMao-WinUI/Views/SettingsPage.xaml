<Page x:Class="IMao_WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="22">
        <StackPanel Spacing="5"><TextBlock Text="PREFERENCES" Style="{StaticResource IMaoEyebrowStyle}" /><TextBlock Text="设置" Style="{StaticResource IMaoPageTitleStyle}" /><TextBlock Text="把显示、运行和操作习惯调整到适合你的状态。" Style="{StaticResource IMaoSecondaryTextStyle}" /></StackPanel>
        <Border Style="{StaticResource IMaoCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="版本与地图资源" Style="{StaticResource IMaoSectionTitleStyle}" />
                <TextBlock x:Name="UpdateVersions" Style="{StaticResource IMaoBodyTextStyle}" />
                <TextBlock x:Name="UpdateLastChecked" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <ToggleSwitch x:Name="AutomaticUpdateCheck" Header="启动后检查更新" OnContent="每天最多检查一次，由你决定安装" OffContent="仅手动检查" Toggled="AutomaticUpdateCheck_Toggled" />
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="CheckUpdates_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                    <Button x:Name="InstallResourcesButton" Content="下载并安装地图资源" Click="InstallResources_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                    <Button x:Name="ImportResourcesButton" Content="导入离线包" Click="ImportResources_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                    <Button x:Name="RollbackResourcesButton" Content="回退上一版" Click="RollbackResources_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                    <Button x:Name="RepairUpdateStateButton" Content="修复更新状态" Click="RepairUpdateState_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Visibility="Collapsed" />
                    <Button x:Name="DownloadProgramButton" Content="下载新版程序" Click="DownloadProgram_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                    <Button x:Name="RestartProgramButton" Content="退出并更新" Click="RestartProgram_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                    <Button x:Name="RollbackProgramButton" Content="回退程序版本" Click="RollbackProgram_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                    <Button x:Name="CancelUpdateButton" Content="取消" Click="CancelUpdate_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                </controls:WrapPanel>
                <ProgressBar x:Name="ResourceUpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                <TextBlock x:Name="ResourceUpdateProgressText" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <TextBlock x:Name="ResourceUpdateNotes" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <InfoBar x:Name="ResourceUpdateMessage" IsOpen="True" IsClosable="False" />
                <TextBlock Text="地图资源在完整退出并重新打开软件后启用。点位进度、路线和个人设置继续保存在本机。" Style="{StaticResource IMaoSecondaryTextStyle}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource IMaoCardStyle}">
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="更新下载源" Style="{StaticResource IMaoSectionTitleStyle}" VerticalAlignment="Center" />
                    <!-- One chip per place a *program package* can come from, which is what this row is about: the
                         signed channel's release assets and the mirror. The mark is the standard check or cancel
                         glyph and the short word beside it says the same thing, because a lone glyph is a guess
                         and "未填 CDK" is neither of the two. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border x:Name="GitHubSourceChip" CornerRadius="6" Padding="9,4" Background="{StaticResource IMaoRaisedSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource IMaoBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE774;" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="GitHub" FontSize="12" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                                <FontIcon x:Name="GitHubSourceMark" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="GitHubSourceStatus" Text="未检测" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="MirrorSourceChip" CornerRadius="6" Padding="9,4" Background="{StaticResource IMaoRaisedSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource IMaoBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE896;" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Mirror酱" FontSize="12" Foreground="{StaticResource IMaoTextBrush}" VerticalAlignment="Center" />
                                <FontIcon x:Name="MirrorSourceMark" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="MirrorSourceStatus" Text="未填 CDK" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="RefreshConnectivityButton" Click="RefreshConnectivity_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" Padding="9,4" ToolTipService.ToolTip="重新检测各下载源的连通性">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Text="GitHub 在国内常常连不上。填写 Mirror酱 的 CDK 后，程序更新会先试国内 CDN，失败再自动回退 GitHub；检查更新不受影响，没有 CDK 也能照常使用。CDK 只以加密形式保存在本机，不会写进日志、导出或崩溃报告。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <PasswordBox x:Name="MirrorChyanCdkBox" Width="280" PlaceholderText="粘贴 Mirror酱 CDK" PasswordRevealMode="Peek" />
                    <Button x:Name="SaveCdkButton" Content="保存 CDK" Click="SaveCdk_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                    <Button x:Name="ClearCdkButton" Content="清除 CDK" Click="ClearCdk_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                    <Button x:Name="OpenMirrorChyanButton" Content="前往 Mirror酱" Click="OpenMirrorChyan_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                </controls:WrapPanel>
                <TextBlock x:Name="MirrorChyanCdkState" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <TextBlock x:Name="ConnectivitySummary" Style="{StaticResource IMaoSecondaryTextStyle}" FontSize="12" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource IMaoCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="地图区域" Style="{StaticResource IMaoSectionTitleStyle}" />
                <TextBlock Text="每个区域是一份独立的特征包：关掉的区域不再加载，定位范围相应缩小。随程序分发的区域不占用下载量；不需要的区域可以直接删掉本机副本腾出空间，之后重新打开会重新下载它一个。列表按库街区大地图的国家分组，点国家标题可以折叠整组。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <TextBlock x:Name="RegionSummary" Style="{StaticResource IMaoBodyTextStyle}" />
                <TextBlock x:Name="RegionCoreState" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <StackPanel x:Name="RegionList" Spacing="6" />
                <TextBlock x:Name="RegionHint" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <ProgressBar x:Name="RegionProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                <TextBlock x:Name="RegionProgressText" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <InfoBar x:Name="RegionMessage" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource IMaoCardStyle}">
            <ContentControl x:Name="RuntimeSettings" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <TextBlock Text="地图显示" Style="{StaticResource IMaoSectionTitleStyle}" />
                <controls:WrapPanel HorizontalSpacing="28" VerticalSpacing="14">
                    <ToggleSwitch x:Name="Setting_MinMapShowItem" Header="小地图点位" Toggled="ToggleSwitch_MinMapShowItem" />
                    <ToggleSwitch x:Name="Setting_MapShowItem" Header="大地图点位" Toggled="ToggleSwitch_MapShowItem" />
                    <ToggleSwitch x:Name="Setting_SetVisibleSavedPoints" Header="显示已完成点" Toggled="ToggleSwitch_SetVisibleSavedPoints" />
                    <ToggleSwitch x:Name="ToggleSwitch_StatusBar" Header="状态条 · 小地图" Toggled="ToggleSwitch_StatusBar_Toggled" />
                    <ToggleSwitch x:Name="ToggleSwitch_MapStatusBar" Header="状态条 · 大地图" Toggled="ToggleSwitch_MapStatusBar_Toggled" />
                    <ToggleSwitch x:Name="ToggleSwitch_StatusBall" Header="小地图状态球" Toggled="ToggleSwitch_StatusBall_Toggled" />
                </controls:WrapPanel>
                <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />
                <TextBlock Text="捕获与刷新" Style="{StaticResource IMaoSectionTitleStyle}" />
                <ComboBox x:Name="ComboBox_CaptureMethod" Header="画面捕获方式" HorizontalAlignment="Stretch" SelectionChanged="CaptureMethod_SelectionChanged">
                    <x:String>BitBlt</x:String><x:String>Windows Graphics Capture</x:String>
                </ComboBox>
                <TextBlock Text="停止叠加后可切换捕获方式。刷新间隔越短，定位更新越频繁，资源消耗也越高。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <ComboBox x:Name="ComboBox_PresentMethod" Header="叠加层呈现方式" HorizontalAlignment="Stretch" SelectionChanged="PresentMethod_SelectionChanged">
                    <x:String>分层窗口（默认）</x:String><x:String>DirectComposition（可选）</x:String>
                </ComboBox>
                <TextBlock Text="分层窗口是默认方式，也是 2026.9.18.1 之前一直在用的方式。DirectComposition 是可选的替代实现，目前没有证据表明它更快：若画面显示异常或帧率异常，请使用「分层窗口」。修改在下次点击「开始探索」后生效。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <controls:WrapPanel HorizontalSpacing="20" VerticalSpacing="12">
                    <NumberBox x:Name="UpdateMinMapItemDataCycle" Header="小地图刷新间隔 · 毫秒" Minimum="16" Maximum="1000" SmallChange="10" ValueChanged="UpdateMinMapItemDataCycle_ValueChanged" SpinButtonPlacementMode="Compact" Width="215" />
                    <NumberBox x:Name="UpdateMapItemDataCycle" Header="大地图刷新间隔 · 毫秒" Minimum="16" Maximum="1000" SmallChange="10" ValueChanged="UpdateMapItemDataCycle_ValueChanged" SpinButtonPlacementMode="Compact" Width="215" />
                </controls:WrapPanel>
                <ToggleSwitch x:Name="AutomaticReplan" Header="偏离路线时自动重排剩余目标" Toggled="AutomaticReplan_Toggled" />
                <TextBlock Text="仅在有活动路线、可靠定位且未暂停时工作；路线页也可随时切换。" Style="{StaticResource IMaoSecondaryTextStyle}" />
            </StackPanel>
            </ContentControl>
        </Border>
        <InfoBar x:Name="RuntimeMessage" IsOpen="False" IsClosable="True" />
        <Border Style="{StaticResource IMaoCardStyle}">
            <StackPanel Spacing="16">
                <TextBlock Text="Xbox 手柄" Style="{StaticResource IMaoSectionTitleStyle}" />
                <ToggleSwitch x:Name="GamepadEnabled" Header="启用手柄操作" OnContent="已启用" OffContent="已关闭" Toggled="GamepadEnabled_Toggled" />
                <ComboBox x:Name="GamepadDevice" Header="使用的手柄" HorizontalAlignment="Stretch" SelectionChanged="GamepadDevice_SelectionChanged">
                    <x:String>自动选择首个连接的手柄</x:String><x:String>手柄 1</x:String><x:String>手柄 2</x:String><x:String>手柄 3</x:String><x:String>手柄 4</x:String>
                </ComboBox>
                <TextBlock x:Name="GamepadStatus" Style="{StaticResource IMaoBodyTextStyle}" />
                <TextBlock x:Name="GamepadInstructions" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <InfoBar x:Name="GamepadMessage" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource IMaoCardStyle}">
            <StackPanel Spacing="16">
                <TextBlock Text="键盘快捷键" Style="{StaticResource IMaoSectionTitleStyle}" />
                <TextBlock Text="选择按键后统一保存。M、F10 和已有重复按键不可分配。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <TextBlock x:Name="CurrentBindings" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <ComboBox x:Name="NearestCompletionKey" Header="完成点位" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="ManualRouteKey" Header="记录手绘线段端点" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="CurrentTargetGuideKey" Header="打开或关闭攻略" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="GuideSkipKey" Header="攻略内长按跳过当前路线目标" HorizontalAlignment="Stretch" />
                <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="12">
                    <ComboBox x:Name="GuidePreviousImageKey" Header="攻略上一张" Width="210" />
                    <ComboBox x:Name="GuideNextImageKey" Header="攻略下一张" Width="210" />
                </controls:WrapPanel>
                <ComboBox x:Name="ToggleEnabledKey" Header="开始/停止探索" HorizontalAlignment="Stretch" />
                <TextBlock Style="{StaticResource IMaoSecondaryTextStyle}"
                           Text="手柄：按住 LB 再按一下 Start 键。键盘：这里选的键，默认 F9。两者都等同于首页的「开始探索 / 停止探索」按钮：既能开始探索，也能停止探索。" />
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <Button x:Name="SaveShortcuts" Content="保存快捷键" Click="SaveShortcuts_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                    <Button x:Name="ResetShortcuts" Content="恢复默认" Click="ResetShortcuts_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                </controls:WrapPanel>
                <InfoBar x:Name="ShortcutMessage" IsOpen="False" IsClosable="True" />
                <TextBlock Text="完成键在游戏中处理小地图附近点，在攻略中只处理当前展示点。快捷键默认作用于范围内离你最近的一个点位；只有两个标记的图标在小地图上互相压住时，才会列出让你选，而且不会批量完成。" Style="{StaticResource IMaoSecondaryTextStyle}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource IMaoCardStyle}">
            <StackPanel Spacing="16">
                <TextBlock Text="操作优化" Style="{StaticResource IMaoSectionTitleStyle}" />
                <TextBlock Text="快捷键只在小地图上离玩家箭头够近的点位里找目标：在这个范围内取离你最近的一个。嫌不够灵敏就调大，嫌容易误触就调小。单位是小地图上的像素（默认 15），修改立即生效。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="12">
                    <NumberBox x:Name="CompletionRangePixels" Header="完成点位触发范围 · 像素" Minimum="5" Maximum="120" SmallChange="5" ValueChanged="CompletionRange_ValueChanged" SpinButtonPlacementMode="Compact" Width="215" />
                    <NumberBox x:Name="GuideRangePixels" Header="查看攻略触发范围 · 像素" Minimum="5" Maximum="120" SmallChange="5" ValueChanged="GuideRange_ValueChanged" SpinButtonPlacementMode="Compact" Width="215" />
                </controls:WrapPanel>
                <InfoBar x:Name="RangeMessage" IsOpen="False" IsClosable="True" />
                <TextBlock Text="范围内有两个以上点位、且它们的图标在小地图上互相压住时，会先列出这些点让你选一个；图标没有压在一起时直接用最近的那个，不再多问一步。查看攻略只是打开窗口，不会改动任何进度。" Style="{StaticResource IMaoSecondaryTextStyle}" />
            </StackPanel>
        </Border>
        <Expander Header="本地点位账本" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Text="账本就是你本地点位完成记录的一份存档。地图只显示当前账本，换账本永远由你自己点；库街区账号最多绑定一个账本，绑定只写在账本封面上，不影响任何点位记录。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <StackPanel x:Name="LocalAccountRows" Spacing="8" />
                <InfoBar x:Name="LocalAccountMessage" IsOpen="False" IsClosable="True" />
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <TextBox x:Name="LocalAccountName" Header="账本名字" PlaceholderText="例如 小号" MaxWidth="200" />
                    <TextBox x:Name="LocalAccountKuro" Header="绑定库街区账号（可留空）" PlaceholderText="例如 10383865" MaxWidth="200" />
                    <Button Content="新建账本" Click="LocalAccountCreate_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                    <Button Content="改名" Click="LocalAccountRename_Click" />
                    <Button Content="绑定 / 解绑" Click="LocalAccountBind_Click" />
                    <Button Content="删除当前账本" Click="LocalAccountDelete_Click" />
                    <Button x:Name="LocalAccountImportButton" Content="导入旧格式记录" Click="LocalAccountImport_Click" Visibility="Collapsed" />
                    <Button Content="打开账本目录" Click="OpenPoints_Click" />
                </controls:WrapPanel>
                <TextBlock Text="新建、改名、绑定只改账本目录，不动任何点位记录；账本的文件名（id）永远不变，因为路线和库街区凭据也按它命名。删除会把这一份存档、它的路线和本机凭据移到 SavedPoints\deleted 下保留，不会真的删掉。" Style="{StaticResource IMaoSecondaryTextStyle}" />
            </StackPanel>
        </Expander>
        <Expander Header="库街区点位进度同步" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Text="先在已登录的库街区鸣潮大地图页通过 IMao 浏览器扩展连接桌面端。凭据只加密保存在当前 Windows 用户下。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <TextBlock x:Name="KuroSyncLedger" TextWrapping="Wrap" />
                <ComboBox x:Name="KuroSyncState" Header="地图区域" MaxWidth="450" SelectionChanged="KuroSyncState_SelectionChanged" />
                <ToggleSwitch x:Name="KuroSyncShowSynced" Header="显示两边都已同步的点位数" OnContent="显示" OffContent="不显示" Toggled="KuroSyncShowSynced_Toggled" />
                <ToggleSwitch x:Name="KuroSyncShowAll" Header="显示没有差异的区域" OnContent="显示" OffContent="不显示" Toggled="KuroSyncShowAll_Toggled" />
                <ToggleSwitch x:Name="KuroSyncAutoSync" Header="自动同步" OnContent="标记后立即推送，并每 10 分钟补齐" OffContent="仅手动同步" Toggled="KuroSyncAutoSync_Toggled" />
                <TextBlock x:Name="KuroAutoSyncStatus" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <Button x:Name="KuroSyncPreviewButton" Content="预览同步" Click="KuroSyncPreview_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                    <Button x:Name="KuroSyncApplyButton" Content="应用同步" Click="KuroSyncApply_Click" IsEnabled="False" />
                    <Button Content="注册/修复浏览器桥接" Click="KuroBridgeRegister_Click" />
                    <Button Content="打开同步数据目录" Click="KuroSyncOpen_Click" />
                    <Button Content="断开库街区连接" Click="KuroSyncDisconnect_Click" />
                </controls:WrapPanel>
                <TextBlock x:Name="KuroBridgeStatus" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                <InfoBar x:Name="KuroSyncMessage" IsOpen="False" IsClosable="True" />
                <StackPanel x:Name="KuroSyncPlanPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="KuroSyncPlanSummary" TextWrapping="Wrap" />
                    <Grid x:Name="KuroSyncPlanGrid" ColumnSpacing="16" RowSpacing="4" />
                    <TextBlock x:Name="KuroSyncPlanFooter" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="区域列表来自库街区，默认同步全部区域。同步只做并集：把库街区独有的完成点拉进本地，把本地独有的写回库街区。只有在库街区明确取消过（本机记录过它曾经勾选）的点，本地才会跟着取消，并在预览表里单独列为“将被取消”。打开自动同步后，你在游戏里标记完成的点位会立刻写回库街区，之后每 10 分钟再整体补齐一次。写入接口已按官方请求格式实测通过（幂等，可安全重试）。" Style="{StaticResource IMaoSecondaryTextStyle}" />
            </StackPanel>
        </Expander>
        <Expander Header="数据与兼容性" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Text="进度与路线保存在本机。打开目录不会修改已有数据。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <Button Content="点位进度目录" Click="OpenPoints_Click" />
                    <Button Content="路线文件目录" Click="OpenRoutes_Click" />
                </controls:WrapPanel>
                <TextBlock Text="若 BitBlt 捕获异常，可应用原有的 Windows 窗口兼容设置。该设置对全部 Direct3D 程序生效，不需要时可以恢复。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <Button Content="应用窗口兼容设置" Click="ApplyWindowCompatibility_Click" />
                    <Button Content="恢复图形默认设置" Click="RestoreWindowCompatibility_Click" />
                </controls:WrapPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</Page>
