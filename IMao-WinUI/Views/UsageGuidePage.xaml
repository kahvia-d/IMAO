<Page x:Class="IMao_WinUI.Views.UsageGuidePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      NavigationCacheMode="Enabled">
    <StackPanel Spacing="16" Padding="0,2,0,20">
        <!-- 顶部寰宇星图探索百科标题栏 -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="AETHERIA FIELD CODEX // 寰宇星图探索百科与历史档案迁移" Style="{StaticResource IMaoEyebrowStyle}" />
                <TextBlock Text="探索百科" Style="{StaticResource IMaoPageTitleStyle}" />
                <TextBlock Text="三步快速启航、手柄与键鼠战术速查，以及旧版本地点位数据的无损扫描与恢复。" Style="{StaticResource IMaoSecondaryTextStyle}" />
            </StackPanel>
            <controls:WrapPanel Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                <Button Content="前往路线" Click="OpenFunctions_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                <Button Content="操作设置" Click="OpenSettings_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
            </controls:WrapPanel>
        </Grid>

        <!-- 第一层：三步星图启航 Bento 卡片组 -->
        <Border Style="{StaticResource IMaoHeroCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="01 // QUICK ONBOARDING · 开始探索，只需三步" Style="{StaticResource IMaoEyebrowStyle}" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource IMaoSubCardStyle}" BorderBrush="{StaticResource IMaoAccentBorderBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="STEP 01 · 连接游戏" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{StaticResource IMaoAccentBrush}" />
                            <TextBlock Text="在星图总览页点击「开始探索」，进入游戏普通探索画面，等待左上角小地图完成自动定位。" Style="{StaticResource IMaoBodyTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource IMaoSubCardStyle}" BorderBrush="{StaticResource IMaoCyanBorderBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="STEP 02 · 选择想找的点" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{StaticResource IMaoCyanBrush}" />
                            <TextBlock Text="在「点位典藏」按分类、角色或武器勾选目标。修改即时保存，随时可切换显示或隐藏。" Style="{StaticResource IMaoBodyTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource IMaoSubCardStyle}" BorderBrush="{StaticResource IMaoAccentBorderBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="STEP 03 · 按路线逐个收集" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{StaticResource IMaoAccentBrush}" />
                            <TextBlock Text="打开游戏大地图框选成线并开始指引；抵达目标后按快捷键标记完成，或呼出图文攻略核对。" Style="{StaticResource IMaoBodyTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 第二层：双栏战术速查（左「手柄战术速查」 + 右「键鼠、攻略与路线机制」） -->
        <Grid ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左舱：Xbox / PlayStation 手柄速查 -->
            <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="02 // GAMEPAD TACTICAL MATRIX · 手柄速查" Style="{StaticResource IMaoEyebrowStyle}" />
                        <TextBlock Text="Xbox / PlayStation 手柄操作" Style="{StaticResource IMaoSectionTitleStyle}" />
                        <TextBlock Text="A/B/X/Y 对应 ×/○/□/△ · LB/RB 对应 L1/R1 · LS/RS 对应 L3/R3" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource IMaoSubCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="大地图工具台与点位助手" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource IMaoAccentBrush}" />
                            <TextBlock Text="· LB / L1：打开地图工具台（筛选点位、路线规划）&#x0a;· RB / R1：打开点位助手（光标圈对准标记后按 RB 查看详情，长按 A 0.6 秒完成点位）&#x0a;· 左摇杆 + 按住 A 拖动：矩形框选或自由套索选点" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource IMaoSubCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="普通探索与图文攻略窗口" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource IMaoCyanBrush}" />
                            <TextBlock Text="· 先按 LB 再按 B：完成小地图附近点位&#x0a;· 先按 LB 再按 X：打开附近点或当前路线目标的攻略&#x0a;· 攻略内 LB / RB 翻图 · 右摇杆滚动 · X 放大 · 长按 A 0.6 秒完成当前点 · 长按 Y 0.6 秒跳过路线目标" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右舱：键鼠快捷键与路线规则 -->
            <Border Grid.Column="1" Style="{StaticResource IMaoRouteCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="03 // KEYBOARD &amp; ROUTE MECHANICS · 键鼠与攻略机制" Style="{StaticResource IMaoEyebrowStyle}" Foreground="{StaticResource IMaoCyanBrush}" />
                        <TextBlock Text="当前快捷键与大地图交互" Style="{StaticResource IMaoSectionTitleStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource IMaoSubCardStyle}" BorderBrush="{StaticResource IMaoCyanBorderBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="GuideShortcutDescription" Style="{StaticResource IMaoBodyTextStyle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="GuideSkipShortcutDescription" Style="{StaticResource IMaoBodyTextStyle}" />
                            <TextBlock x:Name="GuideCompletionShortcutDescription" Style="{StaticResource IMaoBodyTextStyle}" />
                            <TextBlock x:Name="GuideImageShortcutDescription" Style="{StaticResource IMaoBodyTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource IMaoSubCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="鼠标选点与完成规则" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource IMaoAccentBrush}" />
                            <TextBlock Text="· 普通大地图：左键点击标记看攻略，右键直接切换该点完成状态。&#x0a;· Shift + 左键拖拽：临时矩形框选；Esc 取消未提交选区。&#x0a;· 路线平面连线仅代表直线顺序，不代替攀爬或洞穴入口判断；删除路线绝不影响点位完成进度。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 第三层：左「旧版本地数据修复舱」 + 右「关于 IMao 铭牌舱」 -->
        <Grid ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="04 // LEGACY ARCHIVE RECOVERY · 旧版本地数据无损修复" Style="{StaticResource IMaoEyebrowStyle}" />
                        <TextBlock Text="旧版本地数据修复" Style="{StaticResource IMaoSectionTitleStyle}" />
                        <TextBlock Text="扫描早期单文件 SavedPoints\account_1.json、未登记进度文件或已归档的 deleted 记录本，并无损恢复为独立记录本。" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    </StackPanel>

                    <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                        <Button x:Name="LegacyScanButton" Content="扫描旧数据" Click="LegacyScan_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                        <Button x:Name="LegacyRecoverButton" Content="数据恢复" Click="LegacyRecover_Click" IsEnabled="False" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                    </controls:WrapPanel>

                    <TextBlock x:Name="LegacyScanSummary" Style="{StaticResource IMaoSecondaryTextStyle}" TextWrapping="Wrap" />
                    <StackPanel x:Name="LegacyScanList" Spacing="6" />
                    <InfoBar x:Name="LegacyMessage" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource IMaoHeroCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="05 // ABOUT IMAO · AETHERIA ATLAS EDITION" Style="{StaticResource IMaoEyebrowStyle}" />
                        <TextBlock Text="关于 IMao" Style="{StaticResource IMaoSectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource IMaoBodyTextStyle}" Foreground="{StaticResource IMaoAccentBrush}" FontWeight="Bold" />
                    <TextBlock Text="鸣潮地图探索辅助工具。地图、路线和完成进度在清晰的操作下协作，最终行动由你决定。" Style="{StaticResource IMaoBodyTextStyle}" />
                    <TextBlock x:Uid="SettingsPage_ProjectIntroduction" Style="{StaticResource IMaoSecondaryTextStyle}" />
                    <TextBlock Text="基于 OpenCV、PaddleOCR、Win32CaptureSample、ImGui、nlohmann/json、CommunityToolkit 与 WinUI 构建。" Style="{StaticResource IMaoSecondaryTextStyle}" FontSize="11.5" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                        <HyperlinkButton Content="项目源码" NavigateUri="https://github.com/kahvia-d/WWMAP-TOOLS" />
                        <HyperlinkButton Content="版本发布" NavigateUri="https://github.com/kahvia-d/WWMAP-TOOLS/releases" />
                        <HyperlinkButton Content="原项目" NavigateUri="https://github.com/Yepin2022/IMao-Wuthering-Waves" />
                    </controls:WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Page>
