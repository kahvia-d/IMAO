<Page x:Class="IMao_WinUI.Views.UsageGuidePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <!-- 内置帮助文档统一排版样式：字号、行高与色彩克制统一，便于长文阅读 -->
        <Style x:Key="DocH1Style" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DocLeadStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource IMaoSecondaryTextBrush}" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DocH2Style" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DocBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DocSubtleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource IMaoSecondaryTextBrush}" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <!-- 左右分栏文档阅读器架构：左侧固定章节目录，右侧独立滚动正文 -->
    <Grid ColumnSpacing="18" Padding="0,2,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：文档目录栏 -->
        <Border Grid.Column="0" Style="{StaticResource IMaoCardStyle}" Padding="12,14" VerticalAlignment="Stretch">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2" Padding="6,0">
                    <TextBlock Text="帮助文档" Style="{StaticResource IMaoPageTitleStyle}" FontSize="18" />
                    <TextBlock Text="内置使用说明与操作参考" FontSize="12" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="{StaticResource IMaoBorderBrush}" />

                <StackPanel Grid.Row="2" Spacing="4">
                    <Button x:Name="DocNav_1" Content="1. 快速上手" Tag="doc1" Click="DocNav_Click" Style="{StaticResource IMaoSidebarNavActiveButtonStyle}" FontSize="13" />
                    <Button x:Name="DocNav_2" Content="2. 点位标记与攻略" Tag="doc2" Click="DocNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}" FontSize="13" />
                    <Button x:Name="DocNav_3" Content="3. 路线规划与导航" Tag="doc3" Click="DocNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}" FontSize="13" />
                    <Button x:Name="DocNav_4" Content="4. 键鼠与手柄按键表" Tag="doc4" Click="DocNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}" FontSize="13" />
                    <Button x:Name="DocNav_5" Content="5. 记录本与云同步" Tag="doc5" Click="DocNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}" FontSize="13" />
                    <Button x:Name="DocNav_6" Content="6. 常见问题与旧数据" Tag="doc6" Click="DocNav_Click" Style="{StaticResource IMaoSidebarNavButtonStyle}" FontSize="13" />
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource IMaoSubCardStyle}" Padding="10,8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="当前版本" FontSize="11.5" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                        <TextBlock x:Name="VersionLabel" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource IMaoTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧：文档正文阅读视口 -->
        <Border Grid.Column="1" Style="{StaticResource IMaoCardStyle}" Padding="24,20" VerticalAlignment="Stretch">
            <ScrollViewer x:Name="DocReaderScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18" Padding="0,0,8,16">

                    <!-- ==================== 第 1 章：快速上手 ==================== -->
                    <StackPanel x:Name="DocSection_1" Spacing="14" Visibility="Visible">
                        <StackPanel Spacing="4">
                            <TextBlock Text="1. 快速上手" Style="{StaticResource DocH1Style}" />
                            <TextBlock Text="按照以下准备与步骤，即可在《鸣潮》游戏画面上启用实时地图点位投射与路线导航。" Style="{StaticResource DocLeadStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />

                        <TextBlock Text="1.1 运行环境与画面要求" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="· 显示模式：请将游戏设置为「窗口化」或「无边框窗口」模式（独占全屏模式下系统无法将点位叠加层绘制在游戏上方）。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 分辨率要求：游戏渲染区域分辨率需不低于 1280×720，以确保小地图特征匹配与坐标文字识别精度。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 权限说明：IMao 需要以管理员权限运行，以便与同样具有管理员权限的游戏进程同步窗口位置与快捷键输入。" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="1.2 三步开始探索" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="第一步：筛选感兴趣的收集物" FontWeight="SemiBold" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="前往左侧导航栏的「点位筛选」页，按分类（收集物、探索、采集物、强敌等）或按角色/武器养成材料勾选需要显示在地图上的点位。所有勾选修改会自动保存。" Style="{StaticResource DocSubtleStyle}" />

                                <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />

                                <TextBlock Text="第二步：选择画面来源并启动探索" FontWeight="SemiBold" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="如果使用本地 PC 客户端，直接点击「首页 → 开始探索」即可自动识别游戏窗口；如果使用浏览器游玩云鸣潮，请先点击「选择游戏窗口」指定浏览器标签页窗口，再点击「开始探索」。" Style="{StaticResource DocSubtleStyle}" />

                                <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />

                                <TextBlock Text="第三步：进入游戏查看实时叠加点位" FontWeight="SemiBold" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="回到游戏大世界画面，左上角小地图周围将实时投射附近的目标点位；按 M 打开游戏大地图后，全屏地图上也会同步显示点位图标与路线连线。" Style="{StaticResource DocSubtleStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="1.3 状态条指示说明" Style="{StaticResource DocH2Style}" />
                        <TextBlock Text="开启探索后，小地图下方或大地图顶部会显示状态提示：显示「定位稳定」或「大地图已定位」代表当前坐标跟踪正常；切换到加载界面、背包或剧情画面时会自动暂停绘制，返回大世界后自动恢复。" Style="{StaticResource DocBodyStyle}" />
                    </StackPanel>

                    <!-- ==================== 第 2 章：点位标记与攻略 ==================== -->
                    <StackPanel x:Name="DocSection_2" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="2. 点位标记与攻略" Style="{StaticResource DocH1Style}" />
                            <TextBlock Text="介绍如何在游戏大世界与大地图中查看点位图文攻略、标记点位已完成或取消完成。" Style="{StaticResource DocLeadStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />

                        <TextBlock Text="2.1 在游戏大地图中操作点位" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="· 查看详情与攻略：在游戏内按 M 打开大地图，直接点击叠加层上的任意点位图标（或打开底部中央圆形「地图工具台」），即可查看该点位的名称、所属分层及来自库街区的图文攻略。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 标记完成 / 取消完成：在点位弹窗中点击「完成」即可将该点位记入当前记录本；若需要在地图上核对已收集过的点位，可在「设置 → 捕获与叠加显示」中开启「显示已完成点位」，再次点击已完成点即可取消完成状态。" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="2.2 在大世界中快捷标记与呼出攻略" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="在大世界跑图时无需频繁打开大地图，直接通过快捷键或手柄组合键即可操作玩家周围的点位：" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock x:Name="GuideCompletionShortcutDescription" Style="{StaticResource DocSubtleStyle}" />
                                <TextBlock x:Name="GuideShortcutDescription" Style="{StaticResource DocSubtleStyle}" />
                                <TextBlock Text="提示：若小地图触发范围内同时存在多个紧邻点位，程序会弹出候选列表供你选择，不会误标其它点位。" Style="{StaticResource DocSubtleStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="2.3 独立攻略浮窗操作" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="GuideImageShortcutDescription" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock x:Name="GuideSkipShortcutDescription" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="2.4 多层区域与地下楼层识别" Style="{StaticResource DocH2Style}" />
                        <TextBlock Text="在今州、拉古那、七丘、拉海洛、泰缇斯之底等包含地面与多层地下结构的区域，点位详情与路线目标会自动附带楼层名称（如「地表」「地下 1 层」），并在切换分层地图时对齐显示。" Style="{StaticResource DocBodyStyle}" />
                    </StackPanel>

                    <!-- ==================== 第 3 章：路线规划与导航 ==================== -->
                    <StackPanel x:Name="DocSection_3" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="3. 路线规划与导航" Style="{StaticResource DocH1Style}" />
                            <TextBlock Text="选点画布直接集成在游戏大地图内，桌面端「路线导航」页则负责管理合集、排序与批量导入导出。" Style="{StaticResource DocLeadStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />

                        <TextBlock Text="3.1 打开游戏内地图工具台" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="· 键鼠操作：打开游戏大地图后，点击屏幕底部中央的圆形按钮进入「地图工具台 → 路径自动规划」。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 手柄操作：打开游戏大地图后按 LB 打开地图工具台（按 RB 为点位助手）。" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="3.2 自动选点成线与手绘路线" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="· 自动选点成线：支持单点选择、矩形框选、自由套索、加入当前视野点位与指定起点。按住 Shift + 左键拖拽可临时框选，按 Esc 取消未提交选区（单条路线最多支持 500 个目标点）。点击「生成预览」确认顺序后，点击「开始指引」即可激活导航。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 自由手绘路线：在手绘模式下，单击空白处可新增本地自由点，单击可见点位将其加入路线；从一个点按住鼠标左键拖向另一个点可建立或修改连线方向。鼠标悬停在点位上连续按两次退格键（Backspace）可移除该点，Ctrl+Z 撤销上一步，Esc 结束编辑并保留草稿。" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="3.3 实时导航、偏航重排与刷怪采集" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="· 实时领航：导航开始后，画面会绘制引导实线指向下一站目标；到达后按完成键即可推进到下一站，不想前往的目标可跳过（支持撤销跳过）。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 偏离自动重排：在「设置 → 捕获与叠加显示」中开启「偏离路线时自动重排剩余目标」后，当你偏离原定路线时，程序会以当前位置为起点自动重排未完成目标。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 刷怪采集自动标记：针对声骸或植物采集路线，在游戏内路线面板开启「刷怪采集」后，玩家靠近目标进入设定半径即可自动标记完成。" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="3.4 合集管理、拖拽排序与导入导出" Style="{StaticResource DocH2Style}" />
                        <TextBlock Text="在桌面端「路线导航」页面中，你可以新建或重命名路线合集。在单个合集视图下，直接按住列表中的路线上下拖动即可调整顺序；点击底部「导入路线包」或「导出当前合集」可与其它玩家分享 `.json` 路线文件。" Style="{StaticResource DocBodyStyle}" />
                    </StackPanel>

                    <!-- ==================== 第 4 章：键鼠与手柄按键表 ==================== -->
                    <StackPanel x:Name="DocSection_4" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="4. 键鼠与手柄按键表" Style="{StaticResource DocH1Style}" />
                            <TextBlock Text="汇总游戏内所有键盘快捷键与手柄按键组合。键盘快捷键可在「设置 → 快捷键与手柄」中自定义。" Style="{StaticResource DocLeadStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />

                        <TextBlock Text="4.1 键盘快捷键一览表" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <Grid RowSpacing="10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="功能名称" FontWeight="SemiBold" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="当前按键" FontWeight="SemiBold" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="生效场景与说明" FontWeight="SemiBold" Foreground="{StaticResource IMaoSecondaryTextBrush}" />

                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{StaticResource IMaoBorderBrush}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="开始 / 停止探索" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DocKey_ToggleEnabled" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="全局生效，等同于点击首页「开始探索 / 停止探索」" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="完成附近点位" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DocKey_Complete" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="大世界标记小地图附近点位；攻略窗口内标记当前展示点位" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="打开 / 关闭攻略" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DocKey_Guide" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="打开小地图附近未完成点位攻略，或当前导航路线目标的攻略" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="记录手绘线段端点" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DocKey_ManualRoute" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="大世界跑图时按当前角色坐标记下手绘路线节点" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="攻略内长按跳过目标" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DocKey_GuideSkip" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="在攻略浮窗内按住 0.6 秒跳过当前路线目标（不修改完成状态）" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="攻略图片上 / 下一张" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DocKey_GuideImages" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="7" Grid.Column="2" Text="攻略浮窗显示时切换上一张或下一张攻略配图" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="放大 / 退出攻略大图" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="Enter / Esc" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="8" Grid.Column="2" Text="在攻略浮窗内按 Enter 放大或收起图片，按 Esc 退出大图" Style="{StaticResource DocSubtleStyle}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="4.2 手柄操作一览表（Xbox / PlayStation）" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <Grid RowSpacing="10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="所处场景" FontWeight="SemiBold" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Xbox / PS 按键" FontWeight="SemiBold" Foreground="{StaticResource IMaoSecondaryTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="功能说明" FontWeight="SemiBold" Foreground="{StaticResource IMaoSecondaryTextBrush}" />

                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{StaticResource IMaoBorderBrush}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="全局任意时刻" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="LB + Start (L1 + Options)" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="开始探索 / 停止探索" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="大世界探索" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="先按住 LB，再按 B (○)" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="全部松开后标记附近未完成点位；若有多个紧邻候选则先弹出列表选择" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="大世界探索" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="先按住 LB，再按 X (□)" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="打开附近未完成点位或当前导航目标的独立攻略浮窗" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="游戏大地图" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="点按 LB (L1)" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="打开大地图「地图工具台」（点位筛选、路线规划、框选与套索）" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="游戏大地图" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="点按 RB (R1)" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="打开「点位助手」列出光标圈内点位；A 查看详情，按住 A 0.6 秒标记完成" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="大地图框选 / 套索" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="左摇杆移动 + 按住 A (×)" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="7" Grid.Column="2" Text="移动光标并按住 A 拖动绘制选区，松开 A 完成选点并返回工具栏" Style="{StaticResource DocSubtleStyle}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="独立攻略浮窗" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="LB/RB 翻图 · X 放大 · LS 切焦点" FontWeight="SemiBold" Foreground="{StaticResource IMaoAccentBrush}" />
                                <TextBlock Grid.Row="8" Grid.Column="2" Text="右摇杆滚动文字，按住 A 0.6 秒完成点位，按住 Y 0.6 秒跳过路线目标，B 返回游戏" Style="{StaticResource DocSubtleStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 第 5 章：记录本与库街区同步 ==================== -->
                    <StackPanel x:Name="DocSection_5" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="5. 记录本与库街区同步" Style="{StaticResource DocH1Style}" />
                            <TextBlock Text="支持多账号本地记录本隔离管理，以及与库街区官方大地图的双向并集同步。" Style="{StaticResource DocLeadStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />

                        <TextBlock Text="5.1 本地点位记录本" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="· 多档案独立存储：可在「设置 → 记录本与云同步」中创建多个记录本（如「大号」「小号」）。切换当前记录本后，游戏内地图叠加层与首页「地区完成度」会立即切换显示该记录本的进度。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 安全归档机制：删除记录本不会直接抹除文件，而是将其点位与路线移入 SavedPoints\deleted 目录下归档保留，随时可通过第 6 章的「旧版本地数据恢复」找回。" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="5.2 绑定库街区账号与同步规则" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="1. 连接浏览器扩展：在浏览器中打开已登录的库街区《鸣潮》大地图网页，点击 IMao 浏览器扩展图标并选择「连接桌面端」，将本机凭据安全同步到桌面端。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="2. 绑定记录本 UID：在「设置 → 记录本与云同步」左侧列表中选中要绑定的记录本，点击「修改」，填入扩展中显示的纯数字库街区账号 ID（一个库街区账号最多绑定一个记录本）。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="3. 双向并集同步：点击「预览同步」可提前查看本地与云端的点位差异；本地新增的完成点会上传至库街区，库街区新增的完成点会拉取到本地，绝不会因为云端未标记而冲掉你的本地进度。" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 第 6 章：常见问题与旧数据恢复 ==================== -->
                    <StackPanel x:Name="DocSection_6" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="6. 常见问题与旧数据恢复" Style="{StaticResource DocH1Style}" />
                            <TextBlock Text="常见排障方法、旧版本地数据扫描恢复工具以及软件版本信息。" Style="{StaticResource DocLeadStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource IMaoBorderBrush}" />

                        <TextBlock Text="6.1 常见问题排查" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="· 捕获画面黑屏或静止：可在「设置 → 捕获与叠加显示」中将画面捕获方式切换为「Windows Graphics Capture」，或在「设置 → 数据目录与兼容」中点击「应用窗口兼容设置」。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 地图定位慢或偶发漂移：请确保游戏画面未被弹窗遮挡左上角小地图与左下角坐标区域；可在「设置 → 捕获与叠加显示」中开启「GPU 加速（OCR 坐标识别）」提升识别速度。" Style="{StaticResource DocBodyStyle}" />
                                <TextBlock Text="· 导出排障日志：如遇异常，可前往「运行诊断」页面点击「复制诊断摘要」或开启「3 分钟短时完整采集」生成诊断包。" Style="{StaticResource DocBodyStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="6.2 旧版本地数据扫描与恢复" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="如果从旧版本升级后未看到之前的点位记录，或希望恢复曾删除到 deleted 目录的记录本，请点击下方「扫描旧数据」，勾选条目后点击「数据恢复」：" Style="{StaticResource DocBodyStyle}" />
                                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                                    <Button x:Name="LegacyScanButton" Content="扫描旧数据" Click="LegacyScan_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" />
                                    <Button x:Name="LegacyRecoverButton" Content="数据恢复" Click="LegacyRecover_Click" IsEnabled="False" Style="{StaticResource IMaoSecondaryButtonStyle}" />
                                </controls:WrapPanel>
                                <TextBlock x:Name="LegacyScanSummary" Text="点击「扫描旧数据」查找本机可恢复的旧版点位文件。" Style="{StaticResource DocSubtleStyle}" />
                                <StackPanel x:Name="LegacyScanList" Spacing="8" />
                                <InfoBar x:Name="LegacyMessage" IsOpen="False" IsClosable="True" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="6.3 数据来源与开源说明" Style="{StaticResource DocH2Style}" />
                        <Border Style="{StaticResource IMaoSubCardStyle}" Padding="16,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="地图底图、点位坐标、分类目录及图文攻略内容均来自库街区（KuroBbs）公开接口。" Style="{StaticResource DocSubtleStyle}" />
                                <HyperlinkButton Content="访问 GitHub 开源仓库（WWMAP-TOOLS / IMao）"
                                                 NavigateUri="https://github.com/God-ok/IMao-Wuthering-Waves"
                                                 Padding="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
