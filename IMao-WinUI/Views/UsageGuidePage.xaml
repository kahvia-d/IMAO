<Page x:Class="IMao_WinUI.Views.UsageGuidePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls" NavigationCacheMode="Enabled">
 <StackPanel Spacing="22">
  <StackPanel Spacing="5"><TextBlock Text="FIELD GUIDE" Style="{StaticResource IMaoEyebrowStyle}" /><TextBlock Text="帮助" Style="{StaticResource IMaoPageTitleStyle}" /><TextBlock Text="从第一次连接，到完成一条自己的探索路线。" Style="{StaticResource IMaoSecondaryTextStyle}" /></StackPanel>
  <Border Style="{StaticResource IMaoCardStyle}"><StackPanel Spacing="14">
   <TextBlock Text="开始探索，只需三步" Style="{StaticResource IMaoSectionTitleStyle}" />
   <TextBlock Text="01   连接游戏" Style="{StaticResource IMaoBodyTextStyle}" /><TextBlock Text="在概览页启动叠加，进入普通探索画面，等待小地图位置确认。" Style="{StaticResource IMaoSecondaryTextStyle}" />
   <TextBlock Text="02   选择想找的点" Style="{StaticResource IMaoBodyTextStyle}" /><TextBlock Text="在点位筛选页按类型、角色或武器查找。勾选自动保存，不影响已完成记录。" Style="{StaticResource IMaoSecondaryTextStyle}" />
   <TextBlock Text="03   按路线逐个收集" Style="{StaticResource IMaoBodyTextStyle}" /><TextBlock Text="打开游戏大地图选点，生成预览后开始导航。到达目标后确认完成，或打开攻略查看图片。" Style="{StaticResource IMaoSecondaryTextStyle}" />
   <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"><Button Content="前往路线" Click="OpenFunctions_Click" Style="{StaticResource IMaoPrimaryButtonStyle}" /><Button Content="操作设置" Click="OpenSettings_Click" Style="{StaticResource IMaoSecondaryButtonStyle}" /></controls:WrapPanel>
  </StackPanel></Border>
  <Expander Header="手柄速查" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
   <TextBlock Text="游戏大地图" Style="{StaticResource IMaoSectionTitleStyle}" />
   <TextBlock Text="LB · 地图工具台     RB · 点位助手&#x0a;将游戏白色光标圈对准标记后按 RB；圈内点优先显示，A 查看详情，详情页按住 X 0.6 秒完成所选点。&#x0a;左摇杆 / 方向键 · 选择     A · 确认     B · 逐级返回，根层返回游戏&#x0a;框选或套索：左摇杆移动光标，按住 A 拖动，松开提交。筛选搜索文字使用键盘输入。" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock Text="普通探索与攻略" Style="{StaticResource IMaoSectionTitleStyle}" />
   <TextBlock Text="先按 LB，再按 B · 完成附近点     先按 LB，再按 X · 打开附近攻略&#x0a;组合键全部松开后执行一次；完成范围内有多个点时，先选择，再按 A 完成所选点。附近攻略只查询当前筛选中的未完成点。&#x0a;攻略内 LB / RB · 翻图     右摇杆 · 滚动     A · 放大     B · 返回&#x0a;详情页按住 X 0.6 秒，只完成当前展示的点。" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock Text="进入工具后先松开按键；断连后需释放再重新操作。组合键是否与游戏其他状态冲突仍以实际游戏响应为准。" Style="{StaticResource IMaoSecondaryTextStyle}" />
  </StackPanel></Expander>
  <Expander Header="攻略与点位完成" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
   <TextBlock x:Name="GuideShortcutDescription" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock x:Name="GuideCompletionShortcutDescription" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock x:Name="GuideImageShortcutDescription" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock Text="普通大地图左键点击具体标记查看攻略；重叠点先展开，再选其中一个。右键切换该点完成状态。选点模式中的左键增删路线目标，不能批量完成。" Style="{StaticResource IMaoSecondaryTextStyle}" />
   <TextBlock Text="完成成功保存后关闭攻略，失败时保留窗口与错误提示。完成快捷键不会撤销已经完成的记录。" Style="{StaticResource IMaoSecondaryTextStyle}" />
  </StackPanel></Expander>
  <Expander Header="路线：选点、预览与导航" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
   <TextBlock Text="选点：新建自动路线后，可直接点击点位切换选中，也可在游戏大地图框选、套索或加入当前视野，最多 500 个目标。再次点击可移除已选点位；选多了可撤销或逐点移除，缺少可靠位置时可指定起点。" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock Text="预览：生成后查看访问顺序，再开始导航。新预览不会替换现有活动路线，直到你启用它。" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock Text="导航：确认完成后推进当前目标；跳过只改变这条路线，可以撤销。偏离后可手动重算，也可在路线页开启自动重排。" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock Text="暂停保留静态路线，继续后恢复指引；退出导航结束活动选择，保存的路线文件仍在。加载路线后需手动继续。删除路线不删除点位完成记录。" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock Text="路线按平面距离组织，不能代替游戏中的绕路、攀爬或洞穴入口判断。" Style="{StaticResource IMaoSecondaryTextStyle}" />
  </StackPanel></Expander>
  <Expander Header="鼠标与取消操作" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
   <TextBlock Text="Shift＋左键拖拽：临时矩形框选，可从标记上开始。&#x0a;Esc：先取消未完成选区，没有选区时返回移动地图。&#x0a;滚轮：交给游戏缩放地图。失焦或地图变换会取消未提交选区，已选目标保留。" Style="{StaticResource IMaoBodyTextStyle}" />
  </StackPanel></Expander>
  <Border Style="{StaticResource IMaoCardStyle}"><StackPanel Spacing="12">
   <TextBlock Text="关于 IMao" Style="{StaticResource IMaoSectionTitleStyle}" /><TextBlock x:Name="VersionLabel" Style="{StaticResource IMaoSecondaryTextStyle}" />
   <TextBlock Text="鸣潮地图探索辅助工具。地图、路线和完成进度在清晰的操作下协作，最终行动由你决定。" Style="{StaticResource IMaoBodyTextStyle}" />
   <TextBlock x:Uid="SettingsPage_ProjectIntroduction" Style="{StaticResource IMaoSecondaryTextStyle}" />
   <TextBlock Text="使用 OpenCV、PaddleOCR、Win32CaptureSample、ImGui、nlohmann/json、CommunityToolkit 与 WinUI。" Style="{StaticResource IMaoSecondaryTextStyle}" />
   <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><HyperlinkButton Content="项目源码" NavigateUri="https://github.com/kahvia-d/WWMAP-TOOLS" /><HyperlinkButton Content="版本发布" NavigateUri="https://github.com/kahvia-d/WWMAP-TOOLS/releases" /><HyperlinkButton Content="原项目" NavigateUri="https://github.com/Yepin2022/IMao-Wuthering-Waves" /></controls:WrapPanel>
  </StackPanel></Border>
 </StackPanel>
</Page>
