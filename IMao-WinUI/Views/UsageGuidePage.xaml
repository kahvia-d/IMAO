<Page
    x:Class="IMao_WinUI.Views.UsageGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">
    <StackPanel Spacing="16">
        <TextBlock Text="使用指南" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="先在启动页连接游戏，并在筛选页勾选要显示的点位类型。地图识别成功后，即可查看攻略、记录完成状态和规划路线。" TextWrapping="Wrap" />
        <Expander Header="如何打开当前点的攻略浮窗" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
                <TextBlock Text="自动路线当前目标：在功能页的自动路径规划中，点击“查看当前目标攻略”。游戏大地图的路线工具条也提供攻略按钮。" TextWrapping="Wrap" />
                <TextBlock x:Name="GuideShortcutDescription" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="GuideCompletionShortcutDescription" TextWrapping="Wrap" />
                <TextBlock x:Name="GuideImageShortcutDescription" TextWrapping="Wrap" />
                <TextBlock Text="普通地图点位：退出自动路线选点后，在游戏大地图上左键点击具体标记。重叠标记先展开，再点击其中一个点。右键会切换完成状态；选点模式中的左键用于增删目标。" TextWrapping="Wrap" />
                <TextBlock Text="攻略浮窗不显示系统标题栏，窗口内提供关闭入口。可翻页、放大图片和确认当前展示的点完成；完成成功保存后自动关闭，保存失败时保留窗口和错误提示。完成快捷键不会撤销已有完成记录。" TextWrapping="Wrap" />
                <Button Content="前往自动路线与攻略入口" Click="OpenFunctions_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Expander>
        <Expander Header="自动路线：选点、导航、退出与删除" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
                <TextBlock Text="1. 在功能页点击“新建自动路线”，回到游戏打开大地图。选择“矩形框选”或“自由套索”拖拽追加目标，也可“加入当前视野”。每条路线最多 500 点，默认排除已完成点。" TextWrapping="Wrap" />
                <TextBlock Text="2. 使用“移动地图”拖图、缩放；已选目标继续保留。套索松开后自动闭合，选多了可撤销或逐点移除。起点默认取玩家位置，缺少可信定位时使用“指定起点”。" TextWrapping="Wrap" />
                <TextBlock Text="3. 点击“生成路线”检查访问顺序，再点击“开始导航”。重新选点或生成预览期间，原活动路线继续保留，直到启用新预览。路线按平面距离排序，需要自己绕路、攀爬和进入洞穴。" TextWrapping="Wrap" />
                <TextBlock Text="4. 到达后手动确认当前目标完成，或“跳过当前目标”。只有完成状态成功保存才会推进；跳过只影响这条路线，可撤销。重新优化剩余顺序需要点击“从当前位置重算”。" TextWrapping="Wrap" />
                <TextBlock Text="5. “暂停”停止动态指引，大地图仍显示静态路线，之后可“继续”；“退出导航”隐藏这条自动路线并清除活动选择，重启不会再恢复它，已保存文件仍可手动加载。“退出选点”仅结束选择目标的操作。" TextWrapping="Wrap" />
                <TextBlock Text="6. 保存的路线可在下拉列表中加载，加载及重启恢复后需手动继续。选择路线并点击“删除选中路线”，确认名称后删除；如果该路线正在导航，也会退出导航，点位完成记录保留。" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>
        <Expander Header="快捷键与自定义" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock x:Name="CurrentBindings" TextWrapping="Wrap" />
                <TextBlock Text="在下面选择按键并一次保存。可选单个字母、数字、功能键、PageUp 或 PageDown，也可禁用；启用的按键不能重复。M 用于地图状态辅助，F10 用于诊断截图，不能分配；Esc 和 Shift 的选点操作固定。" TextWrapping="Wrap" />
                <ComboBox x:Name="NearestCompletionKey" Header="完成点位（小地图附近点／攻略浮窗当前点）" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="ManualRouteKey" Header="记录手绘线段端点（大地图）" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="CurrentTargetGuideKey" Header="打开／关闭攻略浮窗" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="GuidePreviousImageKey" Header="攻略图片：上一张（默认 PageUp）" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="GuideNextImageKey" Header="攻略图片：下一张（默认 PageDown）" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveShortcuts" Content="保存快捷键" Click="SaveShortcuts_Click" />
                    <Button x:Name="ResetShortcuts" Content="恢复默认快捷键" Click="ResetShortcuts_Click" />
                </StackPanel>
                <InfoBar x:Name="ShortcutMessage" IsOpen="False" IsClosable="True" />
                <TextBlock Text="自定义快捷键只接受单键，同时按 Ctrl、Alt、Shift 或 Win 不会触发该工具动作。游戏窗口获得焦点时，附近点完成和手绘路线需要对应地图的有效定位；攻略浮窗获得焦点时，完成键只作用于浮窗当前点，攻略键用于关闭浮窗。攻略显示期间，游戏或攻略窗口获得焦点都可用上一张、下一张按键翻页；攻略隐藏时不会接管翻页按键。手绘快捷键在自动路线选点时暂停。自定义不会修改游戏自身的按键设置，请选择不会干扰游戏操作的按键。" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>
        <Expander Header="固定鼠标操作与取消操作" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
                <TextBlock Text="Shift + 左键拖拽：自动路线选点期间临时使用矩形框选，可以从标记上开始拖拽。" TextWrapping="Wrap" />
                <TextBlock Text="Esc：有未完成选区时取消这次手势；没有手势时返回移动地图。离开规划交互后，Esc 交由游戏处理。" TextWrapping="Wrap" />
                <TextBlock Text="滚轮：交由游戏缩放地图。失焦、定位失效或地图变换时，尚未提交的选区会取消，已选目标继续保留。" TextWrapping="Wrap" />
                <TextBlock Text="普通点位右键：仅切换明确选中的那个点的完成状态。自动路线选点期间，右键不会批量完成目标。" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>
    </StackPanel>
</Page>
