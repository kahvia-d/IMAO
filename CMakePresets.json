{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/windows-x64-release",
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-x64-relwithdebinfo-diagnostics",
      "displayName": "Windows x64 RelWithDebInfo Diagnostics",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/windows-x64-relwithdebinfo-diagnostics",
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "IMAO_ENABLE_DIAGNOSTICS": "ON",
        "IMAO_ALLOW_XML_FEATURE_FALLBACK": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release-core",
      "configurePreset": "windows-x64-release",
      "targets": [
        "IMao-CoreHost"
      ]
    },
    {
      "name": "windows-x64-relwithdebinfo-diagnostics-core",
      "configurePreset": "windows-x64-relwithdebinfo-diagnostics",
      "targets": [
        "IMao-CoreHost"
      ]
    },
    {
      "name": "windows-x64-relwithdebinfo-diagnostics-kuro-builder",
      "configurePreset": "windows-x64-relwithdebinfo-diagnostics",
      "targets": [
        "KuroMapFeatureBuilder"
      ]
    },
    {
      "name": "windows-x64-release-feature-converter",
      "configurePreset": "windows-x64-release",
      "targets": [
        "IMaoFeatureConverter"
      ]
    },
    {
      "name": "windows-x64-release-capture-assistant",
      "configurePreset": "windows-x64-release",
      "targets": [
        "IMaoCaptureAssistant"
      ]
    },
    {
      "name": "windows-x64-release-visual-index-builder",
      "configurePreset": "windows-x64-release",
      "targets": [
        "IMaoVisualIndexBuilder"
      ]
    },
    {
      "name": "windows-x64-release-optimization-tests",
      "configurePreset": "windows-x64-release",
      "targets": [
        "IMaoOptimizationTests"
      ]
    },
    {
      "name": "windows-x64-release-visual-regression",
      "configurePreset": "windows-x64-release",
      "targets": [
        "IMaoVisualRegression"
      ]
    },
    {
      "name": "windows-x64-release-coordinate-regression",
      "configurePreset": "windows-x64-release",
      "targets": [
        "IMaoCoordinateRegression"
      ]
    }
  ]
}
