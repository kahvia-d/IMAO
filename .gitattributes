# The v1.0.2 map-feature database is archived out of the packaged asset tree: every region pack now carries
# its own calibrated features, so the program no longer ships it. It stays in LFS because the archived
# binaries are still large and the repository has to remain cloneable.
archive/retired-base-features/** filter=lfs diff=lfs merge=lfs -text
# The XML source of the archived feature database stays in the asset tree: it is a build input for
# rebuilding the binaries above and release staging already excludes it.
Assets/FeaturesDatas/Map_features.yml filter=lfs diff=lfs merge=lfs -text
Assets/FeaturesDatas/**/visual-index.imx filter=lfs diff=lfs merge=lfs -text
Assets/FeaturesDatas/KuroTilePacks/**/features.yml filter=lfs diff=lfs merge=lfs -text
Assets/FeaturesDatas/KuroTilePacks/**/features.imf filter=lfs diff=lfs merge=lfs -text
Assets/FeaturesDatas/KuroTilePacks/**/features.imf.manifest.json filter=lfs diff=lfs merge=lfs -text
# Candidate index headers hash their source manifest. Keep checkout bytes stable.
Assets/FeaturesDatas/**/manifest.json text eol=lf
