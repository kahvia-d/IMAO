<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Declaring x64 keeps the referenced core project's output under x64\Release
         instead of the repository root when the app build publishes this bridge. -->
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../IMao-WinUI.Core/IMao-WinUI.Core.csproj" />
  </ItemGroup>
</Project>
