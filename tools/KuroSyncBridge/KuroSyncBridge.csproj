<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Declaring x64 keeps the referenced core project's output under x64\Release
         instead of the repository root when the app build publishes this bridge. -->
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The bridge is a stable component: it should be the same bytes from one release to the next unless its
         own source changes, so that a version directory can share it instead of copying another 65 MB. The
         SDK appends the source revision to InformationalVersion by itself, which alone was enough to make
         every release differ. Provenance travels in the package's build-info.json instead. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../IMao-WinUI.Core/IMao-WinUI.Core.csproj" />
  </ItemGroup>
</Project>
