<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Version.props" />
  <PropertyGroup>
    <!-- The launcher is a stable component, not a copy of the application. Version.props stamps the
         application version into every project that imports it, which for a 65 MB self-contained single file
         meant the bytes changed every release while its contents had not - so each version directory carried
         its own copy instead of sharing one. Its identity is the launcher protocol; see IMaoLauncherVersion.
         The source revision is left out for the same reason: provenance travels in launcher-build-info.json,
         which ships beside it, and the application version is in that package's build-info.json. -->
    <Version>$(IMaoLauncherVersion)</Version>
    <AssemblyVersion>$(IMaoLauncherVersion)</AssemblyVersion>
    <FileVersion>$(IMaoLauncherVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0</TargetFramework>
    <AssemblyName>IMao-Launcher</AssemblyName><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The bundle carries a whole .NET runtime; deflating it takes 64.99 MB to 33.93 MB and a measured
         54 ms of launch time, once per program start. It does not shrink the download: the program shards
         are ZipArchive CompressionLevel.Optimal (tools/UpdatePublisher/Program.cs:455), so the shard ZIP
         already deflates this payload - swapping a compressed launcher into the ui shard moved its ZIP
         from 60.58 MB to 59.34 MB. This is a disk win, not a bandwidth one. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The launcher is what players open and pin, so it carries the same icon as the program. -->
    <ApplicationIcon>..\..\Assets\WindowIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../IMao-WinUI.Core/Updates/*.cs" Link="Updates/%(Filename)%(Extension)" />
    <!-- The update sources name these two, and this project compiles them by glob rather than referencing the
         assembly, so they have to be listed. Named one by one on purpose: Helpers/Json.cs would drag
         Newtonsoft.Json into the launcher, which has no other use for it. -->
    <Compile Include="../../IMao-WinUI.Core/Helpers/AtomicFile.cs" Link="Helpers/%(Filename)%(Extension)" />
    <Compile Include="../../IMao-WinUI.Core/Helpers/CurrentUserDpapi.cs" Link="Helpers/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Assets/Updates/trusted-keys.json" LogicalName="trusted-keys.json" />
  </ItemGroup>
</Project>
