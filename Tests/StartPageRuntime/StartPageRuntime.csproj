<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <StartPageSource Condition="'$(StartPageSource)' == ''">../../IMao-WinUI/Views/StartPage.xaml.cs</StartPageSource>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>StartPageRuntime</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableDefaultPriItems>true</EnableDefaultPriItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>../../out/start-page-runtime/</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultLanguage>zh-CN</DefaultLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.250402" />
    <Manifest Include="$(ApplicationManifest)" />
    <Page Include="../../IMao-WinUI/Views/StartPage.xaml" Link="Views/StartPage.xaml" />
    <Compile Include="$(StartPageSource)" Link="Views/StartPage.xaml.cs" />
    <Compile Include="../../IMao-WinUI/Helpers/RegionalProgressReader.cs" Link="Production/RegionalProgressReader.cs" />
    <Compile Include="../../IMao-WinUI/Helpers/BoolToVisibilityConverter.cs" Link="Production/BoolToVisibilityConverter.cs" />
    <Compile Include="../../IMao-WinUI/Models/CoreRuntimeStatus.cs" Link="Production/CoreRuntimeStatus.cs" />
    <Compile Include="../../IMao-WinUI/Models/RoutePlanningState.cs" Link="Production/RoutePlanningState.cs" />
    <Page Include="../../IMao-WinUI/Styles/IMaoTheme.xaml" Link="Styles/IMaoTheme.xaml" />
    <Page Include="../../IMao-WinUI/Styles/Thickness.xaml" Link="Styles/Thickness.xaml" />
  </ItemGroup>
</Project>
